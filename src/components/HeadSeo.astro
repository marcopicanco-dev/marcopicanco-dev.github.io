---
import { SITE, TWITTER_USERNAME, OG_IMAGE } from '@/config'
import { type Frontmatter } from '@/types'
import { getCanonicalUrl } from '@/utils/seo'

type Props = {
  frontmatter?: Frontmatter
  type?: string
}

const { frontmatter, type } = Astro.props as Props

const canonicalUrl = getCanonicalUrl(Astro.url.pathname, Astro.site)

const formattedContentTitle = frontmatter?.title
  ? frontmatter.title + ' - ' + SITE.title
  : SITE.title

const imageAlt = frontmatter?.heroImageAlt ?? SITE.title
const imageUrl = new URL(frontmatter?.heroImage ?? OG_IMAGE, Astro.site)

const ogType = type ?? 'website'
const description = frontmatter?.description ?? SITE.description
---

<!-- Page Metadata -->
<title>{formattedContentTitle}</title>
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="description" content={description} />
<meta property="og:description" content={description} />

<!-- OpenGraph Tags -->
<meta property="og:title" content={formattedContentTitle} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={SITE.defaultLanguage} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={SITE.title} />
{
  ogType === 'article' && (
    <>
      <meta name="author" content={SITE.title} />
      <meta
        property="article:author"
        content={new URL('/sobre/', Astro.site)}
      />
      {frontmatter?.date && (
        <meta property="article:published_time" content={frontmatter.date} />
      )}
      {frontmatter?.tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter Tags -->
<meta name="twitter:card" content="summary_large_image" />
{TWITTER_USERNAME && <meta name="twitter:site" content={TWITTER_USERNAME} />}
<meta name="twitter:title" content={formattedContentTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
