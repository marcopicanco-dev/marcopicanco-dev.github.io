---
import { DEFAULT_LANGUAGE_CODE, SITE, TWITTER_USERNAME } from '@/config'
import { type Frontmatter } from '@/types'
import { LOCALE_INFO } from '@/i18n/ui'
import { getAlternateLinks } from '@/i18n/alternates'
import { getLang, getTranslations, localizePath } from '@/i18n/utils'
import { getCanonicalUrl } from '@/utils/seo'

type Props = {
  frontmatter?: Frontmatter
  type?: string
}

const { frontmatter, type } = Astro.props as Props
const lang = getLang(Astro.currentLocale)
const t = getTranslations(lang)

const canonicalUrl = getCanonicalUrl(Astro.url.pathname, Astro.site)

const withSiteName = (title?: string) =>
  title ? title + ' - ' + SITE.title : SITE.title

// Search results show about 60 characters, so long titles can set a shorter
// seoTitle. Social cards have more room and keep the full title.
const formattedContentTitle = withSiteName(
  frontmatter?.seoTitle ?? frontmatter?.title,
)
const socialTitle = withSiteName(frontmatter?.title)

const imageAlt = frontmatter?.heroImageAlt ?? SITE.title
const imageUrl = new URL(
  frontmatter?.heroImage ?? LOCALE_INFO[lang].ogImage,
  Astro.site,
)

// Other language versions of this page; a single entry means there are none.
const alternates = getAlternateLinks(Astro.url.pathname)
const hasAlternates = alternates.length > 1
const defaultAlternate = alternates.find(
  (alternate) => alternate.lang === DEFAULT_LANGUAGE_CODE,
)

const ogType = type ?? 'website'
const description = frontmatter?.description ?? t('site.description')
---

<!-- Page Metadata -->
<title>{formattedContentTitle}</title>
<link rel="canonical" href={canonicalUrl} />
<link rel="sitemap" href="/sitemap-index.xml" />
{
  hasAlternates &&
    alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={LOCALE_INFO[alternate.lang].hreflang}
        href={new URL(alternate.path, Astro.site)}
      />
    ))
}
{
  hasAlternates && defaultAlternate && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(defaultAlternate.path, Astro.site)}
    />
  )
}
<meta name="description" content={description} />
<meta property="og:description" content={description} />

<!-- OpenGraph Tags -->
<meta property="og:title" content={socialTitle} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={LOCALE_INFO[lang].ogLocale} />
{
  alternates
    .filter((alternate) => alternate.lang !== lang)
    .map((alternate) => (
      <meta
        property="og:locale:alternate"
        content={LOCALE_INFO[alternate.lang].ogLocale}
      />
    ))
}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={SITE.title} />
{
  ogType === 'article' && (
    <>
      <meta name="author" content={SITE.title} />
      <meta
        property="article:author"
        content={new URL(localizePath('/sobre/', lang), Astro.site)}
      />
      {frontmatter?.date && (
        <meta property="article:published_time" content={frontmatter.date} />
      )}
      {frontmatter?.tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter Tags -->
<meta name="twitter:card" content="summary_large_image" />
{TWITTER_USERNAME && <meta name="twitter:site" content={TWITTER_USERNAME} />}
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
