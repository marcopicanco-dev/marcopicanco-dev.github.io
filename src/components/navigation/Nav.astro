---
import { PROJECT_NAME } from '@/config'
import ThemeSwitcher from '@/components/navigation/ThemeSwitcher.astro'
import MobileNav from '@/components/navigation/MobileNav.astro'

const isHome = [
  '/',
  '/portfolio/',
  '/portfolio',
  '/pt/',
  '/pt',
  '/sr/',
  '/sr',
].includes(Astro.url.pathname)
const sectionHref = (id: string) => (isHome ? `#${id}` : `/#${id}`)
const navLinks = [
  { label: 'Projetos', href: sectionHref('projetos') },
  { label: 'Serviços', href: sectionHref('servicos') },
  { label: 'Sobre', href: '/sobre/' },
  { label: 'Contato', href: sectionHref('contato') },
]
---

<header class="site-header">
  <div class="site-container header-inner">
    <a class="brand" href="/" aria-label={`${PROJECT_NAME} — início`}>
      <svg
        class="brand-symbol"
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M0 0h14v14H0zM28 14a14 14 0 0 1-14 14V14h14Z"></path>
        <path d="M14 0a14 14 0 0 1 14 14h-3a11 11 0 0 0-11-11Z"></path>
      </svg>
      <span>{PROJECT_NAME}<span class="brand-dot">.</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <a
        class="header-blog"
        href="/blog/"
        aria-current={Astro.url.pathname === '/blog/' ? 'page' : undefined}
        >Blog <span aria-hidden="true">↗</span></a
      >
      <ThemeSwitcher />
      <MobileNav links={navLinks} />
    </div>
  </div>
</header>
