---
import { PROJECT_NAME } from '@/config'
import ThemeSwitcher from '@/components/navigation/ThemeSwitcher.astro'
import MobileNav from '@/components/navigation/MobileNav.astro'
import LanguageFlags from '@/components/navigation/LanguageFlags.astro'
import { getLang, getTranslations, localizePath } from '@/i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = getTranslations(lang)
const homeHref = localizePath('/', lang)
const blogHref = localizePath('/blog/', lang)
const isHome = Astro.url.pathname === homeHref
const sectionHref = (id: string) => (isHome ? `#${id}` : `${homeHref}#${id}`)
const navLinks = [
  { label: t('nav.projects'), href: sectionHref('projetos') },
  { label: t('nav.services'), href: sectionHref('servicos') },
  { label: t('nav.about'), href: localizePath('/sobre/', lang) },
  { label: t('nav.contact'), href: sectionHref('contato') },
]
---

<header class="site-header">
  <div class="site-container header-inner">
    <a
      class="brand"
      href={homeHref}
      aria-label={t('nav.homeLabel', { name: PROJECT_NAME })}
    >
      <svg
        class="brand-symbol"
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M0 0h14v14H0zM28 14a14 14 0 0 1-14 14V14h14Z"></path>
        <path d="M14 0a14 14 0 0 1 14 14h-3a11 11 0 0 0-11-11Z"></path>
      </svg>
      <span>{PROJECT_NAME}<span class="brand-dot">.</span></span>
    </a>
    <nav class="desktop-nav" aria-label={t('nav.main')}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <a
        class="header-blog"
        href={blogHref}
        aria-current={Astro.url.pathname === blogHref ? 'page' : undefined}
        >{t('nav.blog')} <span aria-hidden="true">↗</span></a
      >
      <LanguageFlags class="header-languages" />
      <ThemeSwitcher />
      <MobileNav links={navLinks} />
    </div>
  </div>
</header>
