---
import {
  GITHUB_REPO_URL,
  LINKEDIN_URL,
  PROJECT_NAME,
  DEFAULT_LANGUAGE_CODE,
} from '@/config'

import { type LanguageKeys, LANGUAGES } from '@/i18n/ui'
import { type SearchRecord } from '@/types'
import { getSearchRecords } from '@/utils/blog'

import ThemeSwitcher from '@/components/navigation/ThemeSwitcher.astro'
import Search from '@/components/navigation/Search'
import MobileNav from '@/components/navigation/MobileNav.astro'

const langFromURL = Astro.url.pathname.split('/')[1] || DEFAULT_LANGUAGE_CODE
const lang: LanguageKeys = Object.prototype.hasOwnProperty.call(
  LANGUAGES,
  langFromURL,
)
  ? (langFromURL as LanguageKeys)
  : DEFAULT_LANGUAGE_CODE

const isPortfolioPage = Astro.url.pathname.replace(/\/$/, '') === '/portfolio'
const portfolioSectionHref = (sectionId: string) =>
  isPortfolioPage ? `#${sectionId}` : `/portfolio/#${sectionId}`

const navLinks = [
  { label: 'Home', href: portfolioSectionHref('inicio') },
  { label: 'Blog', href: '/blog/' },
  { label: 'Projetos', href: portfolioSectionHref('projetos') },
  { label: 'Consultoria', href: portfolioSectionHref('consultoria') },
  { label: 'Sobre', href: portfolioSectionHref('sobre') },
  { label: 'Contato', href: portfolioSectionHref('contato') },
]

const getSearchItems = async () => {
  return getSearchRecords()
}

const searchItems: SearchRecord[] = await getSearchItems()
---

<nav
  class="fixed left-0 top-0 z-[60] h-20 w-full border-b border-black/20 bg-opacity-50 backdrop-blur-md backdrop-filter dark:border-white/20"
  aria-label="Navegação principal"
>
  <div
    class="mx-auto flex h-20 w-full items-center justify-between px-8 py-5 w500:px-5"
  >
    <div class="flex items-center">
      <a
        class="mr-10 inline-block transition-opacity hover:opacity-70 w800:mr-0"
        href={lang === DEFAULT_LANGUAGE_CODE ? '/' : `/${lang}`}
      >
        <span class="text-2xl font-bold w500:text-xl">{PROJECT_NAME}</span>
      </a>

      <div class="z-20 w800:hidden">
        <Search items={searchItems} lang={lang} client:only="react" />
      </div>
    </div>

    <div class="flex items-center text-lg">
      <div class="mr-10 flex items-center gap-10 w800:hidden">
        {
          navLinks.map((link) => (
            <a class="hover:opacity-70" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </div>
      <a
        class="mr-6 hover:opacity-70 w800:hidden"
        target="_blank"
        rel="noopener noreferrer"
        href={GITHUB_REPO_URL}
        aria-label="Abrir GitHub de Marco Picanço"
      >
        <svg
          class="h-6 w-6"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1024 1024"
          ><path
            class="fill-lightModeIcon transition-colors dark:fill-darkModeIcon"
            d="m1024 525c0 225.9-146.6 417.9-348.8 485.8-25.6 5.1-35.2-10.9-35.2-24.4 0-17.2.6-72.3.6-140.8 0-48-16-78.7-34.5-94.7 113.9-12.8 233.6-56.3 233.6-252.8 0-56.3-19.9-101.7-52.5-137.6 5.1-12.8 23-65.3-5.1-135.7 0 0-42.9-14-140.8 52.5-41-11.5-84.5-17.3-128-17.3s-87.1 5.8-128 17.3c-97.9-65.9-140.8-52.5-140.8-52.5-28.2 70.4-10.3 122.9-5.1 135.7-32.7 35.9-52.5 81.9-52.5 137.6 0 195.9 119 240 232.9 252.8-14.7 12.8-28.1 35.2-32.6 68.5-29.4 13.4-103 35.2-149.1-42.2-9.6-15.4-38.4-53.2-78.7-52.5-42.9.6-17.3 24.3.6 33.9 21.8 12.2 46.7 57.6 52.5 72.3 10.2 28.8 43.5 83.9 172.1 60.2 0 42.9.7 83.2.7 95.3 0 13.5-9.6 28.8-35.2 24.4-203.5-67.9-350.1-259.2-350.1-485.8 0-282.9 229.1-512 512-512s512 229.1 512 512z"
            fill-rule="evenodd"></path></svg
        >
      </a>
      <a
        class="mr-10 hover:opacity-70 w800:hidden"
        target="_blank"
        rel="noopener noreferrer"
        href={LINKEDIN_URL}
        aria-label="Abrir LinkedIn de Marco Picanço"
      >
        <svg
          class="h-6 w-6"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5zM.5 8h4V24h-4V8zm7.5 0h3.7v2.22h.05c.52-.98 1.79-2.02 3.68-2.02 3.94 0 4.67 2.6 4.67 5.98V24h-4V13.5c0-2.42-.04-5.53-3.38-5.53-3.38 0-3.9 2.64-3.9 5.37V24H8V8z"
          ></path>
        </svg>
      </a>
      <div class="w800:hidden">
        <ThemeSwitcher />
      </div>
      <MobileNav />
    </div>
  </div>
</nav>
