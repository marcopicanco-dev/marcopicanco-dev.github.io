<div class="theme-switcher relative z-20" transition:persist>
  <button
    type="button"
    class="theme-switcher-button icon-button"
    aria-label="Alterar tema"
    aria-expanded="false"
  >
    <svg
      class="h-5 w-5"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        class="stroke-current"
        d="M12 3a9 9 0 1 0 0 18V3Z"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        class="stroke-current"
        d="M12 3a9 9 0 0 1 0 18"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <div
    class="theme-switcher-menu invisible absolute right-0 top-12 min-w-32 border py-1 opacity-0"
  >
    <button
      type="button"
      class="theme-option flex w-full items-center justify-between px-4 py-3 text-left text-sm"
      data-theme-value="light"
      aria-pressed="false"
    >
      <span>Claro</span>
      <span class="theme-check hidden">✓</span>
    </button>
    <button
      type="button"
      class="theme-option flex w-full items-center justify-between px-4 py-3 text-left text-sm"
      data-theme-value="dark"
      aria-pressed="false"
    >
      <span>Escuro</span>
      <span class="theme-check hidden">✓</span>
    </button>
  </div>
</div>
