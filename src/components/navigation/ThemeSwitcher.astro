<div class="theme-switcher relative z-20" transition:persist>
  <button
    type="button"
    class="theme-switcher-button inline-flex h-10 w-10 items-center justify-center rounded-base border border-draculaBorder/40 bg-draculaPanel/95 text-draculaText transition hover:border-draculaAccent hover:text-draculaAccent"
    aria-label="Alterar tema"
    aria-expanded="false"
  >
    <svg
      class="h-5 w-5"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        class="stroke-current"
        d="M12 3a9 9 0 1 0 0 18V3Z"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        class="stroke-current"
        d="M12 3a9 9 0 0 1 0 18"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <div
    class="theme-switcher-menu invisible absolute right-0 top-12 min-w-32 rounded-base border border-draculaBorder/40 bg-draculaPanel/95 py-1 opacity-0 shadow-lg transition-all"
  >
    <button
      type="button"
      class="theme-option flex w-full items-center justify-between px-4 py-2 text-left text-sm text-draculaText transition hover:bg-darkModeBgHover hover:text-draculaAccent"
      data-theme-value="light"
    >
      <span>Claro</span>
      <span class="theme-check hidden">✓</span>
    </button>
    <button
      type="button"
      class="theme-option flex w-full items-center justify-between px-4 py-2 text-left text-sm text-draculaText transition hover:bg-darkModeBgHover hover:text-draculaAccent"
      data-theme-value="dark"
    >
      <span>Escuro</span>
      <span class="theme-check hidden">✓</span>
    </button>
  </div>
</div>

<script>
  import {
    LIGHT_MODE_CODE_BLOCK_THEME,
    DARK_MODE_CODE_BLOCK_THEME,
  } from '@/config'

  type Theme = 'light' | 'dark'

  const themeSwitcherButtonSelector = '.theme-switcher-button'
  const themeSwitcherMenuSelector = '.theme-switcher-menu'

  const applyTheme = (theme: Theme) => {
    const element = document.documentElement

    if (theme === 'dark') {
      element.classList.add('dark')
      element.setAttribute('data-theme', DARK_MODE_CODE_BLOCK_THEME as string)
    } else {
      element.classList.remove('dark')
      element.setAttribute('data-theme', LIGHT_MODE_CODE_BLOCK_THEME as string)
    }

    localStorage.setItem('theme', theme)
    updateThemeChecks(theme)
  }

  const getCurrentTheme = (): Theme => {
    if (localStorage.theme === 'dark' || localStorage.theme === 'light') {
      return localStorage.theme
    }

    return document.documentElement.classList.contains('dark')
      ? 'dark'
      : 'light'
  }

  const updateThemeChecks = (theme: Theme) => {
    const options = document.querySelectorAll<HTMLElement>('.theme-option')

    options.forEach((option) => {
      const isSelected = option.dataset.themeValue === theme
      const check = option.querySelector('.theme-check')

      check?.classList.toggle('hidden', !isSelected)
    })
  }

  const closeThemeMenus = () => {
    const switchers = document.querySelectorAll<HTMLElement>('.theme-switcher')

    switchers.forEach((root) => {
      const button = root.querySelector(
        themeSwitcherButtonSelector,
      ) as HTMLButtonElement | null
      const menu = root.querySelector(
        themeSwitcherMenuSelector,
      ) as HTMLElement | null

      button?.setAttribute('aria-expanded', 'false')
      menu?.classList.add('invisible', 'opacity-0')
      menu?.classList.remove('visible', 'opacity-100')
    })
  }

  const setupThemeSwitcher = () => {
    updateThemeChecks(getCurrentTheme())

    const switchers = document.querySelectorAll<HTMLElement>('.theme-switcher')

    switchers.forEach((root) => {
      if (root.dataset.bound === 'true') return
      root.dataset.bound = 'true'

      const button = root.querySelector(
        themeSwitcherButtonSelector,
      ) as HTMLButtonElement | null
      const menu = root.querySelector(
        themeSwitcherMenuSelector,
      ) as HTMLElement | null

      button?.addEventListener('click', (event) => {
        event.stopPropagation()
        const isOpen = button.getAttribute('aria-expanded') === 'true'

        closeThemeMenus()

        if (!isOpen) {
          button.setAttribute('aria-expanded', 'true')
          menu?.classList.add('visible', 'opacity-100')
          menu?.classList.remove('invisible', 'opacity-0')
        }
      })

      const options = root.querySelectorAll<HTMLButtonElement>('.theme-option')

      options.forEach((option) => {
        option.addEventListener('click', () => {
          const theme = option.dataset.themeValue

          if (theme === 'light' || theme === 'dark') {
            applyTheme(theme)
            closeThemeMenus()
          }
        })
      })
    })
  }

  setupThemeSwitcher()
  document.addEventListener('click', closeThemeMenus)
  document.addEventListener('astro:after-swap', setupThemeSwitcher)
</script>
