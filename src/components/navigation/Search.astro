---
import { type SearchRecord } from '@/types'
import { getLang, getTranslations } from '@/i18n/utils'

const { items } = Astro.props as { items: SearchRecord[] }
const t = getTranslations(getLang(Astro.currentLocale))
const serializedItems = JSON.stringify(items).replace(/</g, '\\u003c')
---

<div
  data-search-root
  data-search-items={serializedItems}
  data-min-chars={t('search.minChars')}
  data-found-one={t('search.found.one')}
  data-found-other={t('search.found.other')}
  data-no-results={t('search.noResults')}
>
  <button
    type="button"
    data-search-open
    class="button search-trigger"
    aria-haspopup="dialog"
    ><svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      ><circle
        cx="10.5"
        cy="10.5"
        r="6.5"
        stroke="currentColor"
        stroke-width="1.5"></circle><path
        d="m16 16 5 5"
        stroke="currentColor"
        stroke-width="1.5"></path></svg
    >{t('search.open')}</button
  >
  <dialog
    data-search-overlay
    class="search-dialog"
    aria-labelledby="search-title"
  >
    <div class="search-header">
      <h2 id="search-title" class="eyebrow">{t('search.title')}</h2><button
        data-search-close
        class="icon-button"
        type="button"
        aria-label={t('search.close')}>✕</button
      >
    </div>
    <label class="search-label" for="blog-search-input"
      >{t('search.label')}</label
    >
    <input
      id="blog-search-input"
      data-search-input
      type="search"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      aria-describedby="search-feedback"
    />
    <p id="search-feedback" data-search-count role="status">
      {t('search.minChars')}
    </p>
    <div data-search-list class="search-list"></div>
  </dialog>
</div>
<script>
  import '@/scripts/blog-search'
</script>
