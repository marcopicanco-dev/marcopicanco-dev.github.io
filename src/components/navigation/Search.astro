---
import { type SearchRecord } from '@/types'
import { type LanguageKeys, SEARCH } from '@/i18n/ui'
const { items, lang } = Astro.props as {
  items: SearchRecord[]
  lang: LanguageKeys
}
const serializedItems = JSON.stringify(items).replace(/</g, '\\u003c')
---

<div
  data-search-root
  data-search-items={serializedItems}
  data-no-results={SEARCH[lang].noResults}
>
  <button
    type="button"
    data-search-open
    class="button search-trigger"
    aria-haspopup="dialog"
    ><svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      ><circle
        cx="10.5"
        cy="10.5"
        r="6.5"
        stroke="currentColor"
        stroke-width="1.5"></circle><path
        d="m16 16 5 5"
        stroke="currentColor"
        stroke-width="1.5"></path></svg
    >Buscar nos textos</button
  >
  <dialog
    data-search-overlay
    class="search-dialog"
    aria-labelledby="search-title"
  >
    <div class="search-header">
      <h2 id="search-title" class="eyebrow">Buscar no blog</h2><button
        data-search-close
        class="icon-button"
        type="button"
        aria-label="Fechar busca">✕</button
      >
    </div>
    <label class="search-label" for="blog-search-input"
      >O que você está procurando?</label
    >
    <input
      id="blog-search-input"
      data-search-input
      type="search"
      placeholder="Tente Rails, Astro, segurança…"
      autocomplete="off"
      aria-describedby="search-feedback"
    />
    <p id="search-feedback" data-search-count role="status">
      Digite pelo menos 3 caracteres.
    </p>
    <div data-search-list class="search-list"></div>
  </dialog>
</div>
<script>
  import '@/scripts/blog-search'
</script>
