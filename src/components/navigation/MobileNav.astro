---
import LanguageFlags from '@/components/navigation/LanguageFlags.astro'
import { getLang, getTranslations, localizePath } from '@/i18n/utils'

const { links } = Astro.props as { links: { label: string; href: string }[] }
const lang = getLang(Astro.currentLocale)
const t = getTranslations(lang)
---

<button
  id="hamburger-btn"
  class="menu-toggle"
  type="button"
  aria-label={t('nav.openMenu')}
  aria-expanded="false"
  aria-controls="mobile-hamburger"
>
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.5"></path>
  </svg>
</button>
<dialog id="mobile-hamburger" class="mobile-menu" aria-label={t('nav.menu')}>
  <div class="mobile-menu-top">
    <span class="eyebrow">{t('nav.menuTitle')}</span>
    <button
      class="icon-button"
      data-menu-close
      type="button"
      aria-label={t('nav.closeMenu')}>✕</button
    >
  </div>
  <nav aria-label={t('nav.mobile')}>
    {
      links.map((link, index) => (
        <a href={link.href}>
          <span class="mono">0{index + 1}</span>
          {link.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
    <a href={localizePath('/blog/', lang)}
      ><span class="mono">05</span>{t('nav.blog')}<span aria-hidden="true"
        >↗</span
      ></a
    >
  </nav>
  <LanguageFlags class="mobile-menu-languages" />
  <p class="mobile-menu-note">
    {t('nav.menuNoteLine1')}<br />{t('nav.menuNoteLine2')}
  </p>
</dialog>
<script>
  const button = document.querySelector<HTMLButtonElement>('#hamburger-btn')
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-hamburger')
  if (button && dialog) {
    const close = () => dialog.close()
    button.addEventListener('click', () => {
      dialog.showModal()
      button.setAttribute('aria-expanded', 'true')
      document.body.style.overflow = 'hidden'
    })
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', close)
    dialog
      .querySelectorAll('a')
      .forEach((link) => link.addEventListener('click', close))
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        const bounds = dialog.getBoundingClientRect()
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        )
          close()
      }
    })
    dialog.addEventListener('close', () => {
      button.setAttribute('aria-expanded', 'false')
      document.body.style.overflow = ''
    })
    window
      .matchMedia('(min-width: 901px)')
      .addEventListener('change', (event) => {
        if (event.matches && dialog.open) close()
      })
  }
</script>
