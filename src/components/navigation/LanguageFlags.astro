---
import { LOCALE_INFO, type LanguageKeys } from '@/i18n/ui'
import { getAlternatePath } from '@/i18n/alternates'
import { getLang, getTranslations, isLanguageAvailable } from '@/i18n/utils'

const { class: className } = Astro.props as { class?: string }

const currentLang = getLang(Astro.currentLocale)
const t = getTranslations(currentLang)
const locales = (Object.keys(LOCALE_INFO) as LanguageKeys[]).map((code) => ({
  code,
  ...LOCALE_INFO[code],
  available: isLanguageAvailable(code),
}))
---

<ul
  class:list={['language-flags', className]}
  aria-label={t('language.switcher')}
>
  {
    locales.map((locale) => {
      const isCurrent = locale.code === currentLang
      const flag = (
        <svg
          class="language-flag"
          width="21"
          height="14"
          viewBox="0 0 30 20"
          aria-hidden="true"
        >
          {locale.code === 'pt' && (
            <>
              <rect width="30" height="20" fill="#009c3b" />
              <path d="M15 2 28 10 15 18 2 10Z" fill="#ffdf00" />
              <circle cx="15" cy="10" r="5" fill="#002776" />
              <path
                d="M10.1 9.1Q15 7.8 19.7 11.7"
                fill="none"
                stroke="#fff"
                stroke-width="1"
              />
            </>
          )}
          {locale.code === 'en' && (
            <>
              <rect width="30" height="20" fill="#b22234" />
              <path
                d="M0 1.54h30v1.54H0zM0 4.62h30v1.54H0zM0 7.69h30v1.54H0zM0 10.77h30v1.54H0zM0 13.85h30v1.54H0zM0 16.92h30v1.54H0z"
                fill="#fff"
              />
              <rect width="12" height="10.77" fill="#3c3b6e" />
            </>
          )}
          {locale.code === 'fr' && (
            <>
              <rect width="10" height="20" fill="#002395" />
              <rect x="10" width="10" height="20" fill="#fff" />
              <rect x="20" width="10" height="20" fill="#ed2939" />
            </>
          )}
        </svg>
      )
      return (
        <li>
          {locale.available ? (
            <a
              class="language-flag-link"
              href={getAlternatePath(Astro.url.pathname, locale.code)}
              hreflang={locale.code}
              lang={locale.code}
              aria-current={isCurrent ? 'true' : undefined}
              title={locale.name}
            >
              {flag}
              <span>{locale.flagLabel}</span>
              <span class="sr-only">, {locale.name}</span>
            </a>
          ) : (
            <span
              class="language-flag-link"
              aria-disabled="true"
              title={`${locale.name} — ${t('language.comingSoon')}`}
            >
              {flag}
              <span aria-hidden="true">{locale.flagLabel}</span>
              <span class="sr-only">
                {locale.name} ({t('language.comingSoon')})
              </span>
            </span>
          )}
        </li>
      )
    })
  }
</ul>
