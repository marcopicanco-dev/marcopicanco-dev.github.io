---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { GITHUB_REPO_URL } from '@/config'
import hexaAlertsScreenshot from '@/assets/projects/hexa-alerts-dashboard.png'
import brasilEleitoralScreenshot from '@/assets/projects/brasil-eleitoral-dashboard.png'

type Project = {
  // Slide id, also used by the site search to open a specific project.
  anchor: string
  // Value sent as project_id in the project_click analytics event.
  analyticsId: string
  name: string
  tagline: string
  stack: string
  category: string
  description: string
  proposal: string
  technologies: string
  delivery: string
  repositoryUrl: string
  architectureUrl: string
  screenshot: ImageMetadata
  screenshotAlt: string
  challenges: { title: string; description: string }[]
}

const hexaAlertsUrl = `${GITHUB_REPO_URL}/hexa_alerts`
const brasilEleitoralUrl = `${GITHUB_REPO_URL}/brasil-eleitoral`

const projects: Project[] = [
  {
    anchor: 'projeto-hexa-alerts',
    analyticsId: 'hexa_alerts',
    name: 'HexaAlerts',
    tagline: 'A Copa, lance a lance.',
    stack: 'Ruby on Rails',
    category: 'Projeto autoral / Aplicação web',
    description:
      'A ideia surgiu para não perder nenhum lance da Copa do Mundo e aproveitar o projeto para praticar conceitos importantes de programação: Redis, Sidekiq, webhooks e integração entre provedores de dados.',
    proposal:
      'Reunir partidas, placares e lances em um painel, com alertas conforme as preferências de cada torcedor.',
    technologies: 'Ruby on Rails · PostgreSQL · Redis · Sidekiq · Hotwire',
    delivery:
      'Um acervo de resultados, estatísticas e lances da Copa, com sincronização em segundo plano e atualização no navegador.',
    repositoryUrl: hexaAlertsUrl,
    architectureUrl: `${hexaAlertsUrl}#arquitetura`,
    screenshot: hexaAlertsScreenshot,
    screenshotAlt:
      'Painel do HexaAlerts com resultados da Copa, rankings e acesso às partidas',
    challenges: [
      {
        title: 'Webhooks sem duplicação',
        description:
          'Receber o mesmo evento mais de uma vez sem registrar outro lance ou somar o mesmo gol novamente. Identificadores únicos, índice no banco e bloqueio da partida protegem o processamento concorrente.',
      },
      {
        title: 'Uma partida, vários provedores',
        description:
          'Conciliar IDs e horários diferentes usando as equipes, uma janela de horário e referências externas alternativas. Eventos e assinaturas ficam vinculados à mesma partida.',
      },
      {
        title: 'Filas sem travar o painel',
        description:
          'Responder ao webhook rapidamente e processar os eventos no Sidekiq, com Redis nas filas. Os dados ficam no PostgreSQL, e o Hotwire atualiza o navegador após a persistência.',
      },
      {
        title: 'Sincronização sem perder dados',
        description:
          'Manter a aplicação demonstrável quando uma API fica indisponível, usando um acervo local. A importação protege os placares e estados mais recentes ao combinar dados de fontes diferentes.',
      },
    ],
  },
  {
    anchor: 'projeto-brasil-eleitoral',
    analyticsId: 'brasil_eleitoral',
    name: 'Brasil Eleitoral',
    tagline: 'O país, governo a governo.',
    stack: 'Ruby on Rails',
    category: 'Projeto autoral / Dashboard de dados',
    description:
      'Um dashboard sobre os presidentes que governaram o país desde a redemocratização, em 1985, com contexto político, economia, políticas e resultados eleitorais. Cada número exibido pode ser rastreado até a fonte oficial.',
    proposal:
      'Reunir em um só lugar como cada presidente chegou ao poder e o que marcou cada gestão, com comparação lado a lado entre governos.',
    technologies:
      'Ruby on Rails · PostgreSQL · Tailwind CSS · Hotwire · Docker',
    delivery:
      'Uma linha do tempo com 8 presidentes, 9 governos e 10 eleições, com filtros, gráfico do IPCA, página de metodologia e exportação em CSV.',
    repositoryUrl: brasilEleitoralUrl,
    architectureUrl: `${brasilEleitoralUrl}#coleta-de-dados`,
    screenshot: brasilEleitoralScreenshot,
    screenshotAlt:
      'Dashboard do Brasil Eleitoral com indicadores e a linha do tempo dos governos desde 1985',
    challenges: [
      {
        title: 'Números que podem ser conferidos',
        description:
          'Votos, inflação e leis vêm de fontes oficiais, como TSE, IBGE e Planalto. Cada registro guarda a URL, o arquivo e a data da consulta, para que qualquer pessoa refaça a conta e chegue ao mesmo resultado.',
      },
      {
        title: 'Uma base por eleição',
        description:
          'Somar a votação por turno e candidatura nos arquivos do TSE sem duplicar totais nem misturar consolidações diferentes. Os percentuais são recalculados sobre os votos válidos da mesma fonte.',
      },
      {
        title: 'Navegação sem depender de APIs',
        description:
          'Os dados ficam em arquivos versionados e são importados para o PostgreSQL em uma única transação. A carga é idempotente, e o dashboard continua funcionando quando uma fonte externa fica fora do ar.',
      },
      {
        title: 'Critérios editoriais à vista',
        description:
          'Posições políticas e seleção de políticas são sínteses editoriais, identificadas como tal. Lacunas das fontes aparecem no perfil em vez de serem preenchidas com outra base, e a metodologia explica cada escolha.',
      },
    ],
  },
]

const pad = (number: number) => String(number).padStart(2, '0')
---

<section
  class="project-carousel"
  aria-roledescription="carrossel"
  aria-label="Projetos em destaque"
  data-carousel
>
  <div class="project-carousel-controls">
    <nav class="project-carousel-pager" aria-label="Escolher projeto">
      {
        projects.map((project, index) => (
          <a
            href={`#${project.anchor}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-carousel-link
          >
            <span class="mono">{pad(index + 1)}</span>
            <span class="project-carousel-name">{project.name}</span>
          </a>
        ))
      }
    </nav>
    <div class="project-carousel-arrows" data-carousel-arrows hidden>
      <button type="button" aria-label="Projeto anterior" data-carousel-prev>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" aria-label="Próximo projeto" data-carousel-next>
        <span aria-hidden="true">→</span>
      </button>
    </div>
    <p
      class="sr-only"
      aria-live="polite"
      aria-atomic="true"
      data-carousel-status
    >
    </p>
  </div>
  <div class="project-track" data-carousel-track>
    {
      projects.map((project, index) => (
        <div
          id={project.anchor}
          class="project-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${project.name}, ${index + 1} de ${projects.length}`}
          data-carousel-slide
          data-carousel-name={project.name}
        >
          <article class="project-case">
            <a
              class="project-preview"
              href={project.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.name} / ${project.stack}: ver o projeto no GitHub`}
              data-analytics-project={project.analyticsId}
              data-analytics-location="project_preview"
            >
              <div class="project-preview-bar">
                <span class="mono">
                  {project.name} / {project.stack}
                </span>
                <span aria-hidden="true">↗</span>
              </div>
              <Image
                src={project.screenshot}
                alt={project.screenshotAlt}
                width={1200}
                widths={[480, 800, 1200]}
                sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 900px) 560px, 600px"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="project-info">
              <p class="eyebrow">{project.category}</p>
              <h3>
                {project.name}.<br />
                {project.tagline}
              </h3>
              <p>{project.description}</p>
              <dl class="project-facts">
                <div>
                  <dt>A proposta</dt>
                  <dd>{project.proposal}</dd>
                </div>
                <div>
                  <dt>Tecnologias</dt>
                  <dd>{project.technologies}</dd>
                </div>
                <div>
                  <dt>A entrega</dt>
                  <dd>{project.delivery}</dd>
                </div>
              </dl>
              <a
                class="text-link"
                href={project.architectureUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-analytics-project={project.analyticsId}
                data-analytics-location="project_architecture"
              >
                Conhecer a arquitetura <span aria-hidden="true">↗</span>
              </a>
              <a
                class="project-repository"
                href={project.repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-analytics-project={project.analyticsId}
                data-analytics-location="project_repository"
              >
                Ver repositório ↗
              </a>
            </div>
            <section
              class="project-challenges"
              aria-labelledby={`${project.anchor}-desafios`}
            >
              <h4 id={`${project.anchor}-desafios`}>Principais desafios</h4>
              <ol>
                {project.challenges.map((challenge, challengeIndex) => (
                  <li>
                    <span class="mono" aria-hidden="true">
                      {pad(challengeIndex + 1)}
                    </span>
                    <h5>{challenge.title}</h5>
                    <p>{challenge.description}</p>
                  </li>
                ))}
              </ol>
            </section>
          </article>
        </div>
      ))
    }
  </div>
</section>

<script>
  // Without JavaScript the track still scrolls and snaps, and the pager links
  // jump to each slide. This adds the arrows and keeps only the visible slide
  // reachable by keyboard and screen readers.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]')
  const track = carousel?.querySelector<HTMLElement>('[data-carousel-track]')

  if (carousel && track) {
    const slides = [
      ...track.querySelectorAll<HTMLElement>('[data-carousel-slide]'),
    ]
    const links = [
      ...carousel.querySelectorAll<HTMLAnchorElement>('[data-carousel-link]'),
    ]
    const status = carousel.querySelector<HTMLElement>('[data-carousel-status]')
    let current = -1

    const visibleIndex = () =>
      Math.min(
        slides.length - 1,
        Math.max(0, Math.round(track.scrollLeft / track.clientWidth)),
      )

    const show = (index: number) => {
      if (index === current) return

      const announce = current !== -1
      current = index
      slides.forEach((slide, slideIndex) => {
        slide.inert = slideIndex !== index
      })
      links.forEach((link, linkIndex) => {
        if (linkIndex === index) link.setAttribute('aria-current', 'true')
        else link.removeAttribute('aria-current')
      })
      if (announce && status) {
        status.textContent = `Projeto ${index + 1} de ${slides.length}: ${slides[index].dataset.carouselName}`
      }
    }

    // Wraps around, so the arrows never need to be disabled under focus.
    const goTo = (index: number) => {
      const slide = slides[(index + slides.length) % slides.length]
      const offset =
        slide.getBoundingClientRect().left - track.getBoundingClientRect().left

      track.scrollTo({ left: track.scrollLeft + offset })
    }

    let frame = 0
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame)
        frame = requestAnimationFrame(() => show(visibleIndex()))
      },
      { passive: true },
    )

    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        event.preventDefault()
        goTo(index)
      }),
    )
    carousel
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () => goTo(current - 1))
    carousel
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => goTo(current + 1))

    const arrows = carousel.querySelector<HTMLElement>('[data-carousel-arrows]')
    if (arrows) arrows.hidden = false
    show(visibleIndex())
  }
</script>
