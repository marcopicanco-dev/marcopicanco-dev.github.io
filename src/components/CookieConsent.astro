---
// Markup only: public/scripts/consent.js shows the banner and stores the choice.
import { getLang, getTranslations, localizePath } from '@/i18n/utils'

const lang = getLang(Astro.currentLocale)
const t = getTranslations(lang)
const privacyHref = localizePath('/privacidade/', lang)
---

<section
  class="cookie-banner"
  aria-labelledby="cookie-banner-title"
  data-cookie-banner
  hidden
>
  <div class="site-container cookie-banner-inner">
    <div>
      <h2 id="cookie-banner-title" class="eyebrow">
        {t('cookies.bannerTitle')}
      </h2>
      <p>
        {t('cookies.bannerText')}{' '}
        <a href={privacyHref}>{t('cookies.privacyPolicy')}</a>
      </p>
    </div>
    <div class="cookie-actions">
      <button type="button" class="button" data-cookie-action="reject">
        {t('cookies.reject')}
      </button>
      <button type="button" class="button" data-cookie-action="accept">
        {t('cookies.accept')}
      </button>
      <button
        type="button"
        class="text-link cookie-customize"
        data-cookie-action="preferences"
      >
        {t('cookies.customize')}
      </button>
    </div>
  </div>
</section>

<dialog
  class="cookie-dialog"
  aria-labelledby="cookie-dialog-title"
  data-cookie-dialog
>
  <div class="cookie-dialog-header">
    <h2 id="cookie-dialog-title">{t('cookies.preferences')}</h2>
    <button
      type="button"
      class="cookie-dialog-close"
      aria-label={t('cookies.closeWithoutSaving')}
      data-cookie-action="close">×</button
    >
  </div>
  <p class="cookie-dialog-intro">
    {t('cookies.dialogIntro')}{' '}
    <a href={`${privacyHref}#cookies`}>{t('cookies.dialogIntroLink')}</a>.
  </p>
  <ul class="cookie-categories">
    <li>
      <div class="cookie-category-header">
        <h3>{t('cookies.necessary')}</h3>
        <span class="mono">{t('cookies.alwaysOn')}</span>
      </div>
      <p>
        {t('cookies.necessaryText')}
      </p>
    </li>
    <li>
      <div class="cookie-category-header">
        <label for="cookie-analytics">{t('cookies.analytics')}</label>
        <input
          id="cookie-analytics"
          type="checkbox"
          role="switch"
          data-cookie-analytics
        />
      </div>
      <p>
        {t('cookies.analyticsText')}{' '}{t('cookies.analyticsCookies')}{
          ' '
        }<code>_ga</code>{' '}{t('common.and')}{' '}<code>_ga_*</code>.{' '}{
          t('cookies.analyticsNoAds')
        }
      </p>
    </li>
  </ul>
  <div class="cookie-actions">
    <button type="button" class="button" data-cookie-action="reject">
      {t('cookies.rejectAll')}
    </button>
    <button type="button" class="button" data-cookie-action="accept">
      {t('cookies.acceptAll')}
    </button>
    <button
      type="button"
      class="button button-primary"
      data-cookie-action="save"
    >
      {t('cookies.save')}
    </button>
  </div>
</dialog>
