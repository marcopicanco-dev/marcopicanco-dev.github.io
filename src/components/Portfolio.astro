---
import Base from '@/layouts/Base.astro'
import { Image } from 'astro:assets'
import { CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'
import profilePhoto from '@/assets/profile/perfil-linkedin.png'
import NewTabNote from '@/components/NewTabNote.astro'
import ProjectCarousel from '@/components/ProjectCarousel.astro'
import { HOME } from '@/i18n/pages/home'
import { formatMessage, getLang, localizePath } from '@/i18n/utils'
import {
  formatBlogDate,
  getBlogPosts,
  getBlogPostUrl,
  getSeriesPart,
  sortBlogPostsByDateDesc,
} from '@/utils/blog'

const lang = getLang(Astro.currentLocale)
const c = HOME[lang]
const posts = sortBlogPostsByDateDesc(getBlogPosts(lang))
// A series shows up once, through its first part.
const selectedPosts = posts
  .filter((post) => !post.frontmatter.series || getSeriesPart(post) === 1)
  .slice(0, 3)
const services = c.services.items.map((service, index) => ({
  ...service,
  number: `0${index + 1}`,
}))
---

<Base
  frontmatter={{
    title: c.metaTitle,
    description: c.metaDescription,
    file: '',
  }}
>
  <main>
    <section
      id="inicio"
      class="site-container axis-layout hero"
      aria-labelledby="hero-title"
    >
      <div class="axis hero-axis">
        <span class="mono">MP / DEV</span><span class="side-label"
          >{c.hero.axis}</span
        ><span class="mono" aria-hidden="true">↓</span>
      </div>
      <div class="axis-content hero-content">
        <div class="hero-top">
          <p class="eyebrow">
            <span class="accent-square" aria-hidden="true"></span>{
              c.hero.eyebrow
            }
          </p>
          <svg
            class="modernist-mark"
            viewBox="0 0 80 80"
            fill="none"
            aria-hidden="true"
            ><path d="M0 0h40v40H0z" fill="currentColor"></path><path
              d="M80 40a40 40 0 0 1-40 40V40h40Z"
              fill="currentColor"></path><path
              d="M40 0a40 40 0 0 1 40 40H40V0Z"
              stroke="currentColor"></path></svg
          >
        </div>
        <h1 id="hero-title">
          {c.hero.titleLines[0]}<br />{c.hero.titleLines[1]}<br /><span
            >{c.hero.titleLines[2]}</span
          >
        </h1>
        <div class="hero-bottom">
          <p class="hero-description">
            {c.hero.description}
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contato"
              >{c.hero.primaryCta} <span aria-hidden="true">↗</span></a
            >
            <a class="text-link" href="#servicos"
              >{c.hero.secondaryCta} <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>
        <div class="hero-footnote">
          <span>{c.hero.footnote}</span><div>
            <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer"
              >GitHub <span aria-hidden="true">↗</span><NewTabNote /></a
            ><a
              href={LINKEDIN_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-contact="linkedin"
              data-analytics-location="hero"
              >LinkedIn <span aria-hidden="true">↗</span><NewTabNote /></a
            >
          </div>
        </div>
      </div>
    </section>

    <section
      id="servicos"
      class="site-container axis-layout section-block"
      aria-labelledby="services-title"
    >
      <div class="axis">
        <span class="mono section-number">01 /</span><span class="side-label"
          >{c.services.axis}</span
        >
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">{c.services.eyebrow}</p><h2 id="services-title">
            {c.services.titleLines[0]}<br />{c.services.titleLines[1]}
          </h2><p>
            {c.services.intro}
          </p>
        </div>
        <div class="service-list">
          {
            services.map((service) => (
              <article class="service-row">
                <>
                  <span class="service-number mono">{service.number}</span>
                  <h3>{service.title}</h3>
                  <div>
                    <>
                      <p>{service.description}</p>
                      <p class="service-detail">{service.detail}</p>
                    </>
                  </div>
                  <a
                    class="service-arrow"
                    href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(service.title)}`}
                    aria-label={formatMessage(c.services.contactLabel, {
                      service: service.title.toLowerCase(),
                    })}
                    data-analytics-contact="email"
                    data-analytics-location={`service_${service.number}`}
                  >
                    <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="projetos"
      class="project-section"
      aria-labelledby="project-title"
    >
      <div class="site-container axis-layout section-block">
        <div class="axis">
          <span class="mono section-number">02 /</span><span class="side-label"
            >{c.projects.axis}</span
          >
        </div>
        <div class="axis-content">
          <div class="section-heading section-heading-inline">
            <div>
              <p class="eyebrow">{c.projects.eyebrow}</p><h2 id="project-title">
                {c.projects.title}<br />
              </h2>
            </div><a
              class="text-link"
              href={GITHUB_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              >{c.projects.githubCta}
              <span aria-hidden="true">↗</span><NewTabNote /></a
            >
          </div>
          <ProjectCarousel />
        </div>
      </div>
    </section>

    <section
      id="processo"
      class="site-container axis-layout section-block"
      aria-labelledby="process-title"
    >
      <div class="axis">
        <span class="mono section-number">03 /</span><span class="side-label"
          >{c.process.axis}</span
        >
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">{c.process.eyebrow}</p><h2 id="process-title">
            {c.process.title}
          </h2><p>
            {c.process.intro}
          </p>
        </div><ol class="process-list">
          {
            c.process.steps.map((step, index) => (
              <li>
                <>
                  <span class="mono">0{index + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="sobre"
      class="site-container axis-layout section-block"
      aria-labelledby="about-title"
    >
      <div class="axis">
        <span class="mono section-number">04 /</span><span class="side-label"
          >{c.about.axis}</span
        >
      </div>
      <div class="axis-content about-grid">
        <figure class="portrait">
          <Image
            src={profilePhoto}
            alt="Marco Picanço"
            width={640}
            widths={[320, 640]}
            sizes="(max-width: 600px) 76vw, 320px"
            format="webp"
            loading="lazy"
            decoding="async"
          /><figcaption class="mono">{c.about.caption}</figcaption>
        </figure>
        <div class="about-copy">
          <p class="eyebrow">{c.about.eyebrow}</p><h2 id="about-title">
            {c.about.titleLines[0]}<br />{c.about.titleLines[1]}
          </h2>{c.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<a
            class="text-link"
            href={localizePath('/sobre/', lang)}
            >{c.about.cta} <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    {
      // Hidden until the language has posts of its own.
      selectedPosts.length > 0 && (
        <section
          id="escrita"
          class="site-container axis-layout section-block"
          aria-labelledby="writing-title"
        >
          <div class="axis">
            <>
              <span class="mono section-number">05 /</span>
              <span class="side-label">{c.writing.axis}</span>
            </>
          </div>
          <div class="axis-content">
            <>
              <div class="section-heading section-heading-inline">
                <>
                  <div>
                    <>
                      <p class="eyebrow">{c.writing.eyebrow}</p>
                      <h2 id="writing-title">{c.writing.title}</h2>
                    </>
                  </div>
                  <a class="text-link" href={localizePath('/blog/', lang)}>
                    {c.writing.cta} <span aria-hidden="true">↗</span>
                  </a>
                </>
              </div>
              <div class="writing-list">
                {selectedPosts.map((post) => (
                  <article>
                    <>
                      <time class="mono" datetime={post.frontmatter.date}>
                        {formatBlogDate(post.frontmatter.date, lang)}
                      </time>
                      <h3>
                        <a href={getBlogPostUrl(post.frontmatter)}>
                          {post.frontmatter.title}
                          <span aria-hidden="true">↗</span>
                        </a>
                      </h3>
                    </>
                  </article>
                ))}
              </div>
            </>
          </div>
        </section>
      )
    }

    <section
      id="contato"
      class="contact-section"
      aria-labelledby="contact-title"
    >
      <div class="site-container axis-layout section-block">
        <div class="axis">
          <span class="mono section-number">06 /</span><span class="side-label"
            >{c.contact.axis}</span
          >
        </div><div class="axis-content">
          <p class="eyebrow">{c.contact.eyebrow}</p><h2 id="contact-title">
            {c.contact.titleLines[0]}<br />{c.contact.titleLines[1]}<span
              >?</span
            >
          </h2><div class="contact-bottom">
            <p>
              {c.contact.text}
            </p><div>
              <a
                class="button button-primary"
                href={`mailto:${CONTACT_EMAIL}`}
                data-analytics-contact="email"
                data-analytics-location="contact"
                >{c.contact.emailCta} <span aria-hidden="true">↗</span></a
              ><a
                class="text-link"
                href={LINKEDIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-analytics-contact="linkedin"
                data-analytics-location="contact"
                >{c.contact.linkedinCta}
                <span aria-hidden="true">↗</span><NewTabNote /></a
              >
            </div>
          </div><a
            class="contact-address"
            href={`mailto:${CONTACT_EMAIL}`}
            data-analytics-contact="email"
            data-analytics-location="contact_address">{CONTACT_EMAIL}</a
          >
        </div>
      </div>
    </section>
  </main>
</Base>
