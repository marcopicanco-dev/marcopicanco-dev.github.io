                      <span class="text-base font-black">{index + 1}</span>
                    </div>

                    <span class="h-7 w-px bg-[#f8f8f2]/80" aria-hidden="true" />
                    <span
                      class="h-2.5 w-2.5 rounded-full bg-[#f8f8f2]"
                      aria-hidden="true"
                    />

                    <div
                      class={`flex h-28 w-full items-center justify-center rounded-b-[48px] rounded-t-lg px-4 text-center ${item.accent}`}
                    >
                      <h4 class="text-base font-black leading-5 text-[#f8f8f2]">
                        {item.role}
                      </h4>
                    </div>

                    <span
                      class="h-3 w-0 border-x-[7px] border-t-[10px] border-x-transparent border-t-[#f8f8f2]"
                      aria-hidden="true"
                    />

                    <div class="mt-4 flex min-h-[13rem] w-[84%] flex-col rounded-md border border-[#6272a4]/25 bg-[#282a36] p-4">
                      <p class="text-xs font-semibold leading-5 text-[#50fa7b]">
                        {item.place}
                      </p>
                      <ul class="mt-4 space-y-2 text-sm leading-5 text-[#d7d5ee]">
                        {item.bullets.map((bullet) => (
                          <li class="flex gap-2">
                            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#8be9fd]" />
                            <span>{bullet}</span>
                          </li>
                        ))}
                      </ul>
                      <p class="mt-6 text-xs font-semibold text-[#8be9fd]">
                        {item.company}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 rounded-lg border border-[#6272a4]/20 bg-[#21222c] p-6">
        <h3 class="text-xl font-bold text-[#f8f8f2]">Formação acadêmica</h3>
        <div class="mt-6 divide-y divide-[#6272a4]/20">
          {
            education.map((item) => (
              <article class="grid gap-4 py-6 first:pt-0 last:pb-0 sm:grid-cols-[3rem_1fr]">
                <img
                  class="h-12 w-12 rounded-md border border-[#6272a4]/30 bg-[#f8f8f2] object-cover"
                  src={item.logo}
                  alt={`Logo ${item.school}`}
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                />
                <div class="min-w-0">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h4 class="text-base font-bold leading-6 text-[#f8f8f2]">
                        {item.school}
                      </h4>
                      <p class="mt-1 text-sm leading-6 text-[#d7d5ee]">
                        {item.title}, {item.field}
                      </p>
                      <p class="text-sm font-medium text-[#b7b3ff]">
                        {item.period}
                      </p>
                    </div>
                  </div>
                  <p class="mt-4 max-w-4xl text-sm leading-6 text-[#d7d5ee]">
                    {item.summary}
                  </p>
                  <p class="mt-4 text-sm leading-6 text-[#d7d5ee]">
                    <strong class="font-bold text-[#f8f8f2]">
                      Competências:
                    </strong>{' '}
                    {item.skills.join(', ')}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contato" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16">
      <div
        class="grid gap-8 rounded-lg border border-[#6272a4]/25 bg-[#21222c] p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.32em] text-[#bd93f9]"
          >
            Contato direto
          </p>
          <h2 class="mt-4 text-3xl font-bold text-[#f8f8f2]">
            Vamos conversar sobre o próximo projeto.
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-8 text-[#d7d5ee]">
            Envie uma mensagem para alinhar contexto, objetivo e o melhor
            caminho de implementação.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            class="inline-flex items-center justify-center rounded-lg bg-[#50fa7b] px-5 py-3 text-sm font-bold text-[#282a36] transition hover:bg-[#8be9fd] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
          <a
            class="inline-flex items-center justify-center rounded-lg border border-[#6272a4]/60 px-5 py-3 text-sm font-bold text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            class="inline-flex items-center justify-center rounded-lg bg-[#bd93f9] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#ff79c6] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href={`mailto:${email}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            E-mail
          </a>
        </div>
      </div>
    </section>

    <footer
      class="border-t border-[#6272a4]/20 px-5 py-8 text-sm text-[#d7d5ee]"
    >
      <div
        class="mx-auto grid max-w-6xl items-center gap-5 md:grid-cols-[1fr_auto_1fr]"
      >
        <div class="hidden md:block"></div>
        <p class="text-center">© 2026 Marco Picanço. All rights reserved.</p>
        <div class="flex items-center justify-center gap-3 md:justify-end">
          <a
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[#6272a4]/30 bg-[#21222c] text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#282a36]"
            href={`mailto:${email}`}
            aria-label="Enviar email para Marco Picanço"
          >
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 6h16v12H4V6Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
              <path
                d="m4 7 8 6 8-6"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[#6272a4]/30 bg-[#21222c] text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#282a36]"
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir GitHub de Marco Picanço"
          >
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.86 8.35 6.84 9.71.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.93.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.97c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.4.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.95.68 1.91 0 1.38-.01 2.49-.01 2.83 0 .27.18.59.69.49A10.08 10.08 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
              >
              </path>
            </svg>
          </a>
          <a
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[#6272a4]/30 bg-[#21222c] text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#282a36]"
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir LinkedIn de Marco Picanço"
          >
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1 4.98 2.12 4.98 3.5ZM.5 8h4v16h-4V8Zm7.5 0h3.7v2.22h.05c.52-.98 1.79-2.02 3.68-2.02 3.94 0 4.67 2.6 4.67 5.98V24h-4V13.5c0-2.42-.04-5.53-3.38-5.53-3.38 0-3.9 2.64-3.9 5.37V24H8V8Z"
