---
import Base from '@/layouts/Base.astro'
import { CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'
import {
  formatBlogDate,
  getBlogPosts,
  getBlogPostUrl,
  sortBlogPostsByDateDesc,
} from '@/utils/blog'

const posts = sortBlogPostsByDateDesc(getBlogPosts())
const securityPost = posts.find(
  (post) =>
    post.frontmatter.title ===
    'Corrigindo headers de segurança em um site estático no GitHub Pages com Cloudflare',
)
const selectedPosts = posts
  .filter((post) => !post.frontmatter.title.includes(' - Parte '))
  .slice(0, 3)
const services = [
  {
    number: '01',
    title: 'Sites e presença digital',
    description:
      'Um lugar claro para apresentar seu negócio. Sites rápidos, responsivos e fáceis de navegar, com conteúdo que ajuda seu cliente a dar o próximo passo.',
    detail: 'Sites institucionais · Landing pages · Blogs',
  },
  {
    number: '02',
    title: 'Sistemas e aplicações web',
    description:
      'Menos planilhas paralelas, mais organização. Aplicações que funcionam no navegador para reunir informações, simplificar rotinas e apoiar a operação.',
    detail: 'Ruby on Rails · Backoffice · Bancos de dados',
  },
  {
    number: '03',
    title: 'Integrações e evolução',
    description:
      'Seu software acompanhando o seu negócio. Conecto sistemas, investigo falhas e evoluo o que já existe, com testes e atenção às regras importantes.',
    detail: 'APIs · Webhooks · Manutenção · Testes',
  },
]
const process = [
  {
    title: 'Entender',
    text: 'Conversamos sobre o problema, as pessoas que usam o produto e o que precisa melhorar.',
  },
  {
    title: 'Definir',
    text: 'Alinhamos escopo, prioridades e responsabilidades. Você sabe o que será construído.',
  },
  {
    title: 'Construir',
    text: 'Desenvolvo em etapas, com testes e validações para ajustar o caminho com você.',
  },
  {
    title: 'Acompanhar',
    text: 'Publicamos a solução com documentação e combinamos os próximos passos da evolução.',
  },
]
---

<Base
  frontmatter={{
    title: 'Desenvolvimento web e soluções digitais',
    description:
      'Sites, sistemas e aplicações web para facilitar o dia a dia do seu negócio. Desenvolvimento com Marco Picanço, do entendimento do problema à evolução do produto.',
    file: '',
  }}
>
  <main>
    <section
      id="inicio"
      class="site-container axis-layout hero"
      aria-labelledby="hero-title"
    >
      <div class="axis hero-axis">
        <span class="mono">MP / DEV</span><span class="side-label"
          >Clareza na ideia. Precisão na entrega.</span
        ><span class="mono" aria-hidden="true">↓</span>
      </div>
      <div class="axis-content hero-content">
        <div class="hero-top">
          <p class="eyebrow">
            <span class="accent-square" aria-hidden="true"
            ></span>Desenvolvimento web e aplicações
          </p>
          <svg
            class="modernist-mark"
            viewBox="0 0 80 80"
            fill="none"
            aria-hidden="true"
            ><path d="M0 0h40v40H0z" fill="currentColor"></path><path
              d="M80 40a40 40 0 0 1-40 40V40h40Z"
              fill="currentColor"></path><path
              d="M40 0a40 40 0 0 1 40 40H40V0Z"
              stroke="currentColor"></path></svg
          >
        </div>
        <h1 id="hero-title">
          Boas ideias<br />merecem software<br /><span>bem construído.</span>
        </h1>
        <div class="hero-bottom">
          <p class="hero-description">
            Sites, sistemas e aplicações web pensados para facilitar o dia a dia
            do seu negócio. Do entendimento do problema à evolução do produto.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contato"
              >Conversar sobre um projeto <span aria-hidden="true">↗</span></a
            >
            <a class="text-link" href="#servicos"
              >Conhecer soluções <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>
        <div class="hero-footnote">
          <span>Visão de negócio. Cuidado com o código.</span><div>
            <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer"
              >GitHub ↗</a
            ><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
              >LinkedIn ↗</a
            >
          </div>
        </div>
      </div>
    </section>

    <section
      id="servicos"
      class="site-container axis-layout section-block"
      aria-labelledby="services-title"
    >
      <div class="axis">
        <span class="mono section-number">01 /</span><span class="side-label"
          >Serviços</span
        >
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">O que podemos construir</p><h2 id="services-title">
            Tecnologia que resolve.<br />Sem complicar.
          </h2><p>
            Da primeira presença digital à evolução de um sistema. O ponto de
            partida é o que o seu negócio precisa.
          </p>
        </div>
        <div class="service-list">
          {
            services.map((service) => (
              <article class="service-row">
                <>
                  <span class="service-number mono">{service.number}</span>
                  <h3>{service.title}</h3>
                  <div>
                    <>
                      <p>{service.description}</p>
                      <p class="service-detail">{service.detail}</p>
                    </>
                  </div>
                  <a
                    class="service-arrow"
                    href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(service.title)}`}
                    aria-label={`Conversar sobre ${service.title.toLowerCase()}`}
                  >
                    <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="projetos"
      class="project-section"
      aria-labelledby="project-title"
    >
      <div class="site-container axis-layout section-block">
        <div class="axis">
          <span class="mono section-number">02 /</span><span class="side-label"
            >Na prática</span
          >
        </div>
        <div class="axis-content">
          <div class="section-heading section-heading-inline">
            <div>
              <p class="eyebrow">Projeto selecionado</p><h2 id="project-title">
                O trabalho fala.<br />O código também.
              </h2>
            </div><a
              class="text-link"
              href={GITHUB_REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              >Explorar o GitHub <span aria-hidden="true">↗</span></a
            >
          </div>
          <article class="project-case">
            <a
              class="project-preview"
              href={securityPost
                ? getBlogPostUrl(securityPost.frontmatter)
                : '/blog/'}
              aria-label="Ler o estudo sobre segurança deste site"
              ><div class="project-preview-bar">
                <span class="mono">marcopicanco.com</span><span
                  aria-hidden="true">↗</span
                >
              </div><img
                src="/images/projeto-site.webp"
                alt="Página inicial deste site, com tipografia forte, serviços numerados e identidade modernista"
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
              /></a
            >
            <div class="project-info">
              <p class="eyebrow">Projeto autoral / Site e blog</p><h3>
                Este site.<br />Da interface à infraestrutura.
              </h3><p>
                Um espaço próprio para apresentar meu trabalho e compartilhar
                conhecimento, com código aberto e decisões documentadas.
              </p><dl class="project-facts">
                <div>
                  <dt>O desafio</dt><dd>
                    Publicar conteúdo e cuidar da segurança em uma hospedagem
                    estática.
                  </dd>
                </div><div>
                  <dt>Minha atuação</dt><dd>
                    Desenvolvimento com Astro, configuração de segurança e
                    validações automatizadas.
                  </dd>
                </div><div>
                  <dt>A entrega</dt><dd>
                    Site estático, blog em MDX e verificações de segurança no
                    fluxo de publicação.
                  </dd>
                </div>
              </dl><a
                class="text-link"
                href={securityPost
                  ? getBlogPostUrl(securityPost.frontmatter)
                  : '/blog/'}
                >Ler as decisões do projeto <span aria-hidden="true">↗</span></a
              ><a
                class="project-repository"
                href={`${GITHUB_REPO_URL}/marcopicanco-dev.github.io`}
                target="_blank"
                rel="noopener noreferrer">Ver repositório ↗</a
              >
            </div>
          </article>
        </div>
      </div>
    </section>

    <section
      id="processo"
      class="site-container axis-layout section-block"
      aria-labelledby="process-title"
    >
      <div class="axis">
        <span class="mono section-number">03 /</span><span class="side-label"
          >Como trabalho</span
        >
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">Um caminho compartilhado</p><h2 id="process-title">
            Clareza em cada etapa.
          </h2><p>
            Boas entregas começam com boas conversas. E continuam com decisões
            que fazem sentido para quem vai usar.
          </p>
        </div><ol class="process-list">
          {
            process.map((step, index) => (
              <li>
                <>
                  <span class="mono">0{index + 1}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      id="sobre"
      class="site-container axis-layout section-block"
      aria-labelledby="about-title"
    >
      <div class="axis">
        <span class="mono section-number">04 /</span><span class="side-label"
          >Quem está por trás</span
        >
      </div>
      <div class="axis-content about-grid">
        <figure class="portrait">
          <img
            src="/images/perfil.webp"
            alt="Marco Picanço"
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
          /><figcaption class="mono">Marco Picanço / Desenvolvedor</figcaption>
        </figure>
        <div class="about-copy">
          <p class="eyebrow">Muito prazer, Marco.</p><h2 id="about-title">
            Código com contexto.<br />Tecnologia com propósito.
          </h2><p>
            Sou desenvolvedor Full Stack, com experiência em Ruby on Rails, APIs
            e evolução de sistemas. Antes do software, trabalhei com vendas e
            sucesso do cliente. Essa trajetória me ensinou a ouvir antes de
            propor uma solução.
          </p><p>
            Engenharia de Software, Big Data e Ciência da Computação fazem parte
            da minha formação. A curiosidade por matemática e computação também
            encontra espaço nos textos que publico por aqui.
          </p><a class="text-link" href="/sobre/"
            >Conhecer minha trajetória <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>

    <section
      id="escrita"
      class="site-container axis-layout section-block"
      aria-labelledby="writing-title"
    >
      <div class="axis">
        <span class="mono section-number">05 /</span><span class="side-label"
          >Escrita</span
        >
      </div>
      <div class="axis-content">
        <div class="section-heading section-heading-inline">
          <div>
            <p class="eyebrow">Notas de quem constrói</p><h2 id="writing-title">
              Aprender. Fazer. Compartilhar.
            </h2>
          </div><a class="text-link" href="/blog/"
            >Todos os textos <span aria-hidden="true">↗</span></a
          >
        </div><div class="writing-list">
          {
            selectedPosts.map((post) => (
              <article>
                <>
                  <time class="mono" datetime={post.frontmatter.date}>
                    {formatBlogDate(post.frontmatter.date)}
                  </time>
                  <h3>
                    <a href={getBlogPostUrl(post.frontmatter)}>
                      {post.frontmatter.title}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="contato"
      class="contact-section"
      aria-labelledby="contact-title"
    >
      <div class="site-container axis-layout section-block">
        <div class="axis">
          <span class="mono section-number">06 /</span><span class="side-label"
            >Próximo passo</span
          >
        </div><div class="axis-content">
          <p class="eyebrow">Uma boa conversa é o começo.</p><h2
            id="contact-title"
          >
            O que vamos<br />construir juntos<span>?</span>
          </h2><div class="contact-bottom">
            <p>
              Conte o que você tem em mente, o que precisa resolver ou onde o
              seu projeto parou. Vamos encontrar um caminho.
            </p><div>
              <a class="button button-primary" href={`mailto:${CONTACT_EMAIL}`}
                >Conversar por e-mail <span aria-hidden="true">↗</span></a
              ><a
                class="text-link"
                href={LINKEDIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                >Prefere o LinkedIn? <span aria-hidden="true">↗</span></a
              >
            </div>
          </div><a class="contact-address" href={`mailto:${CONTACT_EMAIL}`}
            >{CONTACT_EMAIL}</a
          >
        </div>
      </div>
    </section>
  </main>
</Base>
