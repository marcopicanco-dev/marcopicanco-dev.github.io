---
import Base from '@/layouts/Base.astro'
import { GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'

const title = 'Portfólio'
const description =
  'Projetos, estudos e consultoria em desenvolvimento de software, dados e tecnologia.'
const emailUser = 'marcopicanco'
const emailDomain = 'live.com'
const profileImage = '/images/perfil.png'

const stats = [
  { value: '+3 anos', label: 'desenvolvendo software' },
  { value: 'Rails', label: 'ecossistema principal' },
  { value: 'APIs', label: 'REST, Webhooks, testes e documentação' },
  { value: 'Dados', label: 'PostgreSQL, MongoDB e Big Data' },
]

const highlights = [
  {
    title: 'Para quem é',
    text: 'Equipes que precisam evoluir sistemas web, corrigir bugs, criar APIs e manter produtos com qualidade técnica e visão de negócio.',
  },
  {
    title: 'O que você leva',
    text: 'Implementação cuidadosa com Ruby on Rails, front end, bancos de dados, testes automatizados e documentação clara.',
  },
  {
    title: 'Diferencial',
    text: 'Vivência prévia em vendas e sucesso do cliente, somada à formação em Engenharia de Software, Big Data e Ciência da Computação.',
  },
]

const businessProblems = [
  {
    id: '01',
    title: 'Backoffice e regras de negócio',
    problem:
      'Fluxos internos lentos, telas difíceis de manter e regras críticas espalhadas pelo sistema.',
    solution:
      'Evoluo backoffices Rails com atenção a permissões, regras complexas e rotinas operacionais que precisam funcionar sem atrito.',
    area: 'Operação interna',
    kind: 'Backoffice',
    metric: 'Rails',
    accent: 'bg-[#bd93f9]',
    tags: ['Rails', 'PostgreSQL', 'Regras de negócio'],
  },
  {
    id: '02',
    title: 'APIs e integrações',
    problem:
      'Sistemas que não conversam bem, processos manuais e integrações sem previsibilidade.',
    solution:
      'Crio, mantenho e documento APIs RESTful para conectar serviços, reduzir retrabalho e tornar integrações mais confiáveis.',
    area: 'Integrações',
    kind: 'APIs RESTful',
    metric: 'JSON',
    accent: 'bg-[#ff79c6]',
    tags: ['REST', 'JSON', 'Documentação'],
  },
  {
    id: '03',
    title: 'Bugs e sustentação',
    problem:
      'Falhas recorrentes, comportamento inesperado em produção e código legado difícil de mexer.',
    solution:
      'Investigo problemas, leio contexto de negócio e faço correções seguras sem quebrar fluxos existentes.',
    area: 'Sustentação',
    kind: 'Correção segura',
    metric: 'Debug',
    accent: 'bg-[#8be9fd]',
    tags: ['Debug', 'Legado', 'Qualidade'],
  },
  {
    id: '04',
    title: 'Testes e confiabilidade',
    problem:
      'Medo de alterar código crítico, regressões frequentes e pouca confiança para evoluir o produto.',
    solution:
      'Escrevo testes automatizados para proteger regras importantes e dar mais segurança às entregas.',
    area: 'Qualidade',
    kind: 'Testes automatizados',
    metric: 'RSpec',
    accent: 'bg-[#50fa7b]',
    tags: ['RSpec', 'Minitest', 'TDD'],
  },
]

const education = [
  {
    school: 'PUC Minas',
    logo: '/images/education/puc-minas.png',
    title: 'Pós-graduação em Engenharia de Software',
    field: 'Ciência da Computação',
    period: 'mar de 2023 - abr de 2024',
    summary:
      'Formação voltada a padrões, práticas e processos de Engenharia de Software para projetar, desenvolver, garantir qualidade e gerenciar soluções de software que geram valor ao negócio.',
    skills: ['SQL', 'Resolução de problemas', 'Engenharia de Software'],
  },
  {
    school: 'Descomplica Faculdade Digital',
    logo: '/images/education/descomplica.png',
    title: 'MBA em Big Data',
    field: 'Tecnologia da Informação',
    period: '2020 - 2021',
    summary:
      'Estudo conceitual e prático de Big Data e Business Analytics, com foco em análise de problemas empresariais, projetos com grandes volumes de dados, qualidade e governança.',
    skills: ['SQL', 'Resolução de problemas', 'Big Data'],
  },
  {
    school: 'Anhanguera Educacional',
    logo: '/images/education/anhanguera.png',
    title: 'Ciência da Computação',
    field: 'Informática',
    period: '2017 - 2021',
    summary:
      'Formação em técnicas, métodos e ferramentas computacionais para automatizar processos e desenvolver sistemas, incluindo modelagem, testes, redes, bancos de dados e inteligência artificial.',
    skills: ['SQL', 'Resolução de problemas', 'Programação'],
  },
  {
    school: 'Estácio',
    logo: '/images/education/estacio.png',
    title: 'Bacharelado em Administração',
    field: 'Administração, Negócios e Marketing',
    period: '2002 - 2006',
    summary:
      'Base em Administração de empresas com foco em Marketing, mundo corporativo, estudos, pesquisas e visão prática sobre negócios.',
    skills: ['Planejamento de eventos', 'Gestão de mudanças', 'Marketing'],
  },
]
---

<Base frontmatter={{ title, description, file: '' }}>
  <main
    class="portfolio-theme min-h-screen bg-[#282a36] text-[#f8f8f2] transition-colors"
  >
    <section class="border-b border-[#6272a4]/20">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-14 px-5 pb-20 pt-12 lg:pb-24"
      >
        <div
          id="inicio"
          class="grid scroll-mt-24 items-center gap-10 lg:grid-cols-[1.08fr_0.92fr]"
        >
          <div>
            <p
              class="portfolio-cyan text-sm font-semibold uppercase tracking-[0.32em]"
            >
              Funcionalidade, usabilidade e qualidade técnica. Sempre.
            </p>
            <h1
              class="mt-5 max-w-4xl text-4xl font-bold leading-[1.05] tracking-tight text-[#f8f8f2] sm:text-6xl lg:text-7xl"
            >
              Desenvolvedor Full Stack Ruby on Rails
            </h1>
            <p class="portfolio-muted mt-7 max-w-2xl text-lg leading-8">
              Desenvolvo aplicações web, APIs, backoffices, com foco em testes,
              manutenção e qualidade.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a
                class="inline-flex items-center justify-center rounded-lg bg-[#bd93f9] px-5 py-3 text-sm font-bold text-[#282a36] transition hover:bg-[#ff79c6] focus:outline-none focus:ring-2 focus:ring-[#8be9fd] focus:ring-offset-2 focus:ring-offset-[#282a36]"
                href="#projetos"
              >
                Ver projetos
              </a>
              <a
                class="inline-flex items-center justify-center rounded-lg border border-[#6272a4]/60 px-5 py-3 text-sm font-bold text-[#f8f8f2] transition hover:border-[#8be9fd] hover:text-[#8be9fd] focus:outline-none focus:ring-2 focus:ring-[#8be9fd] focus:ring-offset-2 focus:ring-offset-[#282a36]"
                href="#contato"
              >
                Falar comigo
              </a>
            </div>
          </div>

          <aside
            class="rounded-lg border border-[#6272a4]/25 bg-[#21222c] p-5 shadow-[0_40px_110px_-55px_rgba(0,0,0,0.9)]"
          >
            <div
              class="flex items-center gap-2 border-b border-[#6272a4]/20 pb-4"
            >
              <span class="h-3 w-3 rounded-full bg-[#ff5555]"></span>
              <span class="h-3 w-3 rounded-full bg-[#f1fa8c]"></span>
              <span class="h-3 w-3 rounded-full bg-[#50fa7b]"></span>
              <span class="portfolio-purple ml-auto text-xs">portfolio.rb</span>
            </div>
            <div
              class="portfolio-muted space-y-5 pt-5 font-mono text-sm leading-7"
            >
              <p>
                foco = <span class="text-[#f1fa8c]"
                  >"resolver problemas reais"</span
                >
              </p>
              <p>
                software<br /><span class="portfolio-green pl-6">.testado</span
                ><br /><span class="portfolio-green pl-6">.bem_escrito</span><br
                /><span class="portfolio-green pl-6">.facil_de_manter</span>
              </p>
            </div>
          </aside>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {
            stats.map((item) => (
              <div class="rounded-lg border border-[#6272a4]/20 bg-[#21222c]/75 p-5">
                <p class="portfolio-cyan text-2xl font-bold">{item.value}</p>
                <p class="portfolio-muted mt-2 text-sm">{item.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-4 px-5 py-14 md:grid-cols-3">
      {
        highlights.map((item) => (
          <article class="rounded-lg border border-[#6272a4]/20 bg-[#21222c]/80 p-6">
            <h2 class="text-lg font-bold text-[#f8f8f2]">{item.title}</h2>
            <p class="portfolio-muted mt-4 text-sm leading-7">{item.text}</p>
          </article>
        ))
      }
    </section>

    <section
      id="projetos"
      class="scroll-mt-24 border-y border-[#6272a4]/20 bg-[#21222c]/45"
    >
      <div class="mx-auto max-w-6xl px-5 py-16">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <p
              class="portfolio-pink text-sm font-semibold uppercase tracking-[0.32em]"
            >
              Portifólio de soluções
            </p>
            <h2
              class="mt-4 max-w-4xl text-3xl font-bold tracking-tight text-[#f8f8f2] sm:text-5xl"
            >
              Projetos orientados a problemas reais de empresa.
            </h2>
            <p class="portfolio-muted mt-5 max-w-3xl text-base leading-8">
              Uma vitrine das frentes em que consigo atuar para reduzir atrito
              operacional, integrar sistemas, estabilizar produtos e acelerar
              entregas com Ruby on Rails.
            </p>
          </div>
          <a
            class="inline-flex items-center justify-center rounded-lg bg-[#50fa7b] px-5 py-3 text-sm font-bold text-[#282a36] transition hover:bg-[#8be9fd] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href="#contato"
          >
            Conversar sobre um problema
          </a>
        </div>

        <p class="portfolio-purple mt-12 text-sm font-bold">
          Lista de soluções
        </p>
        <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          {
            businessProblems.map((item) => (
              <article class="portfolio-solution-card overflow-hidden rounded-lg border border-[#6272a4]/20 transition hover:-translate-y-1 hover:border-[#8be9fd]/70">
                <div class={`relative h-44 overflow-hidden ${item.accent}`}>
                  <div class="absolute inset-x-8 bottom-0 h-32 rounded-t-lg border border-[#282a36]/70 bg-[#11121a] p-3 shadow-[0_20px_45px_-20px_rgba(0,0,0,0.75)]">
                    <div class="flex items-center gap-1.5">
                      <span class="h-2 w-2 rounded-full bg-[#ff79c6]" />
                      <span class="h-2 w-2 rounded-full bg-[#50fa7b]" />
                      <span class="h-2 w-2 rounded-full bg-[#8be9fd]" />
                    </div>
                    <div class="mt-5 space-y-2">
                      <div class="h-1.5 w-3/4 rounded-full bg-[#8be9fd]" />
                      <div class="h-1.5 w-1/2 rounded-full bg-[#bd93f9]" />
                      <div class="h-1.5 w-2/3 rounded-full bg-[#50fa7b]" />
                      <div class="h-1.5 w-5/12 rounded-full bg-[#ff79c6]" />
                    </div>
                    <div class="mt-5 grid grid-cols-2 gap-2">
                      <div class="h-8 rounded-md bg-[#282a36]" />
                      <div class="h-8 rounded-md bg-[#282a36]" />
                    </div>
                  </div>
                </div>

                <div class="p-5">
                  <div class="flex flex-wrap gap-2">
                    <span class="portfolio-chip-label rounded-full px-2.5 py-1 text-[0.68rem] font-bold uppercase">
                      {item.area}
                    </span>
                    <span class="portfolio-chip-metric rounded-full px-2.5 py-1 text-[0.68rem] font-bold uppercase">
                      {item.metric}
                    </span>
                  </div>
                  <h3 class="portfolio-solution-title mt-4 text-lg font-bold leading-6">
                    {item.title}
                  </h3>
                  <p class="portfolio-solution-text mt-3 min-h-[5.25rem] text-sm leading-7">
                    {item.solution}
                  </p>
                  <div class="mt-5 border-t border-[#6272a4]/20 pt-4">
                    <p class="portfolio-solution-kind text-xs font-bold uppercase tracking-[0.14em]">
                      {item.kind}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="consultoria"
      class="scroll-mt-24 border-y border-[#6272a4]/20 bg-[#21222c]/45"
    >
      <div
        class="mx-auto grid max-w-6xl gap-8 px-5 py-16 lg:grid-cols-[0.9fr_1.1fr]"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.32em] text-[#f1fa8c]"
          >
            Consultoria técnica
          </p>
          <h2
            class="mt-5 text-3xl font-bold tracking-tight text-[#f8f8f2] sm:text-5xl"
          >
            Apoio para projetos que precisam sair do rascunho e ganhar forma.
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <article
            class="rounded-lg border border-[#6272a4]/20 bg-[#282a36] p-6"
          >
            <h3 class="portfolio-cyan text-lg font-bold">Escopo possível</h3>
            <p class="portfolio-muted mt-4 text-sm leading-7">
              Sistemas Ruby on Rails, APIs RESTful, Webhooks, correção de bugs,
              testes automatizados, evolução de backoffice e integrações com
              bancos de dados.
            </p>
          </article>
          <article
            class="rounded-lg border border-[#6272a4]/20 bg-[#282a36] p-6"
          >
            <h3 class="portfolio-pink text-lg font-bold">Forma de trabalho</h3>
            <p class="portfolio-muted mt-4 text-sm leading-7">
              Diagnóstico curto, definição de prioridades, implementação com
              qualidade, documentação objetiva e entrega incremental usando
              práticas ágeis.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="sobre" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16">
      <div class="grid gap-10 lg:grid-cols-[0.86fr_1.14fr] lg:items-start">
        <figure
          class="w-full max-w-[280px] overflow-hidden rounded-lg border border-[#6272a4]/20 bg-[#21222c] shadow-[0_28px_90px_-55px_rgba(0,0,0,0.75)] sm:max-w-[320px]"
        >
          <img
            class="aspect-[4/5] h-auto w-full object-cover object-top"
            src={profileImage}
            alt="Retrato profissional de Marco Picanço"
            width="1024"
            height="1536"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div>
          <p
            class="portfolio-green text-sm font-semibold uppercase tracking-[0.32em]"
          >
            Sobre
          </p>
          <h2
            class="mt-5 text-3xl font-bold tracking-tight text-[#f8f8f2] sm:text-5xl"
          >
            Desenvolvedor Full Stack.
          </h2>
          <div class="portfolio-muted mt-7 space-y-5 text-base leading-8">
            <p>
              Sou <strong>Desenvolvedor Full Stack</strong> com mais de 3 anos de
              experiência no ecossistema <strong>Ruby on Rails</strong>, atuando
              na
              <strong>OrçaFascio</strong> com foco no desenvolvimento de APIs, testes
              automatizados e evolução do Backoffice. Uno bagagem técnica em Engenharia
              de Software e Big Data a uma visão estratégica de negócios desenvolvida
              em experiências anteriores em Vendas e Customer Success. Fora do código,
              trago a disciplina e a calma sob pressão de esportes como o jiu-jitsu
              para a minha rotina profissional.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-6 rounded-lg border border-[#6272a4]/20 bg-[#21222c] p-6">
        <h3 class="text-xl font-bold text-[#f8f8f2]">Formação acadêmica</h3>
        <div class="mt-6 divide-y divide-[#6272a4]/20">
          {
            education.map((item) => (
              <details class="portfolio-education-item group py-5 first:pt-0 last:pb-0">
                <summary class="grid cursor-pointer list-none gap-4 rounded-md py-1 outline-none transition focus-visible:ring-2 focus-visible:ring-[#ff79c6] focus-visible:ring-offset-2 focus-visible:ring-offset-[#21222c] sm:grid-cols-[3rem_1fr_auto] sm:items-start">
                  <img
                    class="h-12 w-12 rounded-md border border-[#6272a4]/30 bg-[#f8f8f2] object-cover"
                    src={item.logo}
                    alt={`Logo ${item.school}`}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="min-w-0">
                    <p class="text-base font-bold leading-6 text-[#f8f8f2]">
                      {item.school}
                    </p>
                    <p class="portfolio-muted mt-1 text-sm leading-6">
                      {item.title}, {item.field}
                    </p>
                    <p class="portfolio-purple text-sm font-medium">
                      {item.period}
                    </p>
                  </div>
                  <span
                    class="portfolio-purple flex h-8 w-8 items-center justify-center rounded-md border border-[#6272a4]/25 transition group-open:rotate-180 sm:mt-1"
                    aria-hidden="true"
                  >
                    <svg
                      class="h-4 w-4"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                    >
                      <path
                        d="m6 9 6 6 6-6"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                </summary>

                <div class="grid gap-4 pt-4 sm:grid-cols-[3rem_1fr]">
                  <div class="hidden sm:block" aria-hidden="true" />
                  <div class="min-w-0">
                    <div class="rounded-md border border-[#6272a4]/20 bg-[#282a36]/45 p-4">
                      <p class="portfolio-muted max-w-4xl text-sm leading-6">
                        {item.summary}
                      </p>
                      <p class="portfolio-muted mt-4 text-sm leading-6">
                        <strong class="font-bold text-[#f8f8f2]">
                          Competências:
                        </strong>{' '}
                        {item.skills.join(', ')}
                      </p>
                    </div>
                  </div>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="contato" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-16">
      <div
        class="grid gap-8 rounded-lg border border-[#6272a4]/25 bg-[#21222c] p-6 md:grid-cols-[1fr_auto] md:items-center md:p-8"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.32em] text-[#bd93f9]"
          >
            Contato direto
          </p>
          <h2 class="mt-4 text-3xl font-bold text-[#f8f8f2]">
            Vamos conversar sobre o próximo projeto.
          </h2>
          <p class="portfolio-muted mt-4 max-w-2xl text-base leading-8">
            Envie uma mensagem para alinhar contexto, objetivo e o melhor
            caminho de implementação.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          <a
            class="inline-flex items-center justify-center rounded-lg bg-[#50fa7b] px-5 py-3 text-sm font-bold text-[#282a36] transition hover:bg-[#8be9fd] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
          <a
            class="inline-flex items-center justify-center rounded-lg border border-[#6272a4]/60 px-5 py-3 text-sm font-bold text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            class="portfolio-contact-mail inline-flex items-center justify-center rounded-lg px-5 py-3 text-sm font-bold transition focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#21222c]"
            href="#contato"
            data-email-link
            data-email-user={emailUser}
            data-email-domain={emailDomain}
          >
            E-mail
          </a>
        </div>
      </div>
    </section>

    <footer
      class="portfolio-muted border-t border-[#6272a4]/20 px-5 py-8 text-sm"
    >
      <div
        class="mx-auto grid max-w-6xl items-center gap-5 md:grid-cols-[1fr_auto_1fr]"
      >
        <div class="hidden md:block"></div>
        <p class="text-center">© 2026 Marco Picanço. All rights reserved.</p>
        <div class="flex items-center justify-center gap-3 md:justify-end">
          <a
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[#6272a4]/30 bg-[#21222c] text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#282a36]"
            href="#contato"
            data-email-link
            data-email-user={emailUser}
            data-email-domain={emailDomain}
            aria-label="Enviar email para Marco Picanço"
          >
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 6h16v12H4V6Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"></path>
              <path
                d="m4 7 8 6 8-6"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[#6272a4]/30 bg-[#21222c] text-[#f8f8f2] transition hover:border-[#bd93f9] hover:text-[#bd93f9] focus:outline-none focus:ring-2 focus:ring-[#ff79c6] focus:ring-offset-2 focus:ring-offset-[#282a36]"
            href={GITHUB_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir GitHub de Marco Picanço"
          >
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
