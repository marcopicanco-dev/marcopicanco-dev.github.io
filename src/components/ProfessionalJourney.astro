---

<section id="trajetoria" class="career-section" aria-labelledby="career-title">
  <div class="career-intro">
    <p class="eyebrow">Experiência profissional</p>
    <h2 id="career-title">Antes do<br />código,<br />o contexto.</h2>
    <p class="career-lead">
      Minha trajetória começou ouvindo pessoas. Hoje, transformo esse
      entendimento em software.
    </p>
    <div class="career-company">
      <p class="career-company-name">OrçaFascio</p>
      <p>De vendas e sucesso do cliente ao desenvolvimento de sistemas.</p>
    </div>
  </div>
  <ol
    class="career-timeline"
    aria-label="Experiências profissionais em ordem cronológica"
  >
    {
      experiences.map((experience) => (
        <li class:list={['career-item', { 'is-current': !experience.endedAt }]}>
          <p class="career-company-label eyebrow">
            {experience.company}
            {!experience.endedAt && <span> · Atual</span>}
          </p>
          <h3>{experience.role}</h3>
          <p class="career-period mono">
            <time datetime={experience.startedAt}>{experience.startLabel}</time>
            {' — '}
            {experience.endedAt ? (
              <time datetime={experience.endedAt}>{experience.endLabel}</time>
            ) : (
              <span>atual</span>
            )}
          </p>
          <p class="career-summary">{experience.summary}</p>
          {experience.highlights && (
            <div class="career-highlights">
              <h4>Principais entregas</h4>
              <ul>
                {experience.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          )}
          {experience.technologies && (
            <p class="career-technologies">
              <strong>Tecnologias:</strong>{' '}
              {`${experience.technologies.join(', ')}.`}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .career-section {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    align-items: start;
    gap: 64px;
    margin-top: 80px;
  }
  .career-intro {
    position: sticky;
    top: calc(var(--header-height) + 32px);
  }
  .career-intro > .eyebrow {
    color: var(--muted);
  }
  .career-intro h2 {
    margin-top: 24px;
    font-size: clamp(36px, 4.4vw, 58px);
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }
  .career-lead {
    max-width: 28ch;
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.7;
  }
  .career-company {
    margin-top: 40px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .career-company-name {
    margin-bottom: 4px;
    font-size: 17px;
    font-weight: 550;
    color: var(--ink);
  }
  .career-timeline {
    margin: 0;
    padding: 0 0 0 6px;
    list-style: none;
  }
  .career-item {
    position: relative;
    border-left: 1px solid var(--line);
    padding: 0 0 40px 28px;
  }
  .career-item:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .career-item::before {
    content: '';
    position: absolute;
    top: 4px;
    left: -6px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--paper);
  }
  .career-company-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--muted);
    overflow-wrap: break-word;
  }
  .career-item h3 {
    margin-top: 8px;
    font-size: clamp(21px, 2.1vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .career-period {
    margin-top: 8px;
    font-size: 10px;
    color: var(--muted);
  }
  .career-summary,
  .career-highlights,
  .career-technologies {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    overflow-wrap: break-word;
  }
  .career-highlights h4 {
    margin: 0;
    font-size: 14px;
    font-weight: 550;
    color: var(--ink);
  }
  .career-highlights ul {
    margin: 12px 0 0;
    padding-left: 18px;
    list-style: disc;
  }
  .career-highlights li + li {
    margin-top: 12px;
  }
  .career-technologies strong {
    font-weight: 550;
    color: var(--ink);
  }
  .is-current::before {
    border-color: var(--accent);
    background: var(--accent);
  }
  .is-current > .career-company-label,
  .is-current > h3 {
    color: var(--accent);
  }
  @media (max-width: 1100px) {
    .career-section {
      gap: 40px;
    }
  }
  @media (max-width: 900px) {
    .career-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .career-intro {
      position: static;
    }
    .career-company {
      max-width: 360px;
      margin-top: 28px;
    }
  }
  @media (max-width: 600px) {
    .career-section {
      margin-top: 48px;
      gap: 32px;
    }
    .career-item {
      padding-left: 22px;
      padding-bottom: 32px;
    }
    .career-lead {
      font-size: 16px;
    }
  }
</style>
