---
import { LOCALE_INFO } from '@/i18n/ui'
import { CAREER, type ExperienceId } from '@/i18n/pages/career'
import { getLang } from '@/i18n/utils'

type Experience = {
  id: ExperienceId
  company: string
  startedAt: string
  endedAt?: string
}

const lang = getLang(Astro.currentLocale)
const c = CAREER[lang]

// Labels such as "ago. de 2009" come from the dates, in the page language.
const formatMonth = (yearMonth: string) => {
  const [year, month] = yearMonth.split('-').map(Number)

  return new Date(year, month - 1, 1, 12).toLocaleDateString(
    LOCALE_INFO[lang].htmlLang,
    { month: 'short', year: 'numeric' },
  )
}

const baseExperiences: Experience[] = [
  {
    id: 'telensino',
    company: 'Rede Amapaense de Telensino — Anhanguera S.A. / LFG Macapá',
    startedAt: '2009-08',
    endedAt: '2011-02',
  },
  {
    id: 'monaco',
    company: 'Grupo Mônaco',
    startedAt: '2010-09',
    endedAt: '2011-03',
  },
  {
    id: 'anglo',
    company: 'RH Executiva — Anglo American',
    startedAt: '2012-01',
    endedAt: '2012-05',
  },
  {
    id: 'speed',
    company: 'Speed Treinamentos',
    startedAt: '2017-08',
    endedAt: '2018-02',
  },
  { id: 'proesc', company: 'Proesc', startedAt: '2018-10', endedAt: '2019-02' },
  {
    id: 'orca-sales-assistant',
    company: 'OrçaFascio',
    startedAt: '2019-01',
    endedAt: '2019-05',
  },
  {
    id: 'orca-sales-consultant',
    company: 'OrçaFascio',
    startedAt: '2019-05',
    endedAt: '2020-05',
  },
  {
    id: 'orca-customer-success',
    company: 'OrçaFascio',
    startedAt: '2020-05',
    endedAt: '2022-05',
  },
  { id: 'orca-developer', company: 'OrçaFascio', startedAt: '2022-06' },
]

const experiences = baseExperiences.map((experience) => ({
  ...experience,
  ...c.experiences[experience.id],
  startLabel: formatMonth(experience.startedAt),
  endLabel: experience.endedAt && formatMonth(experience.endedAt),
}))
---

<section id="trajetoria" class="career-section" aria-labelledby="career-title">
  <div class="career-intro">
    <p class="eyebrow">{c.eyebrow}</p>
    <h2 id="career-title">
      {c.titleLines[0]}<br />{c.titleLines[1]}<br />{c.titleLines[2]}
    </h2>
    <p class="career-lead">
      {c.lead}
    </p>
    <div class="career-company">
      <p class="career-company-name">OrçaFascio</p>
      <p>{c.companyText}</p>
    </div>
  </div>
  <ol class="career-timeline" aria-label={c.timelineLabel}>
    {
      experiences.map((experience) => (
        <li class:list={['career-item', { 'is-current': !experience.endedAt }]}>
          <p class="career-company-label eyebrow">
            {experience.company}
            {!experience.endedAt && <span> · {c.current}</span>}
          </p>
          <h3>{experience.role}</h3>
          <p class="career-period mono">
            <time datetime={experience.startedAt}>{experience.startLabel}</time>
            {' — '}
            {experience.endedAt ? (
              <time datetime={experience.endedAt}>{experience.endLabel}</time>
            ) : (
              <span>{c.present}</span>
            )}
          </p>
          <p class="career-summary">{experience.summary}</p>
          {experience.highlights && (
            <div class="career-highlights">
              <h4>{c.highlightsTitle}</h4>
              <ul>
                {experience.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          )}
          {experience.technologies && (
            <p class="career-technologies">
              <strong>{c.technologiesLabel}</strong>{' '}
              {`${experience.technologies.join(', ')}.`}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .career-section {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    align-items: start;
    gap: 64px;
    margin-top: 80px;
  }
  .career-intro {
    position: sticky;
    top: calc(var(--header-height) + 32px);
  }
  .career-intro > .eyebrow {
    color: var(--muted);
  }
  .career-intro h2 {
    margin-top: 24px;
    font-size: clamp(36px, 4.4vw, 58px);
    font-weight: 550;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }
  .career-lead {
    max-width: 28ch;
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.7;
  }
  .career-company {
    margin-top: 40px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .career-company-name {
    margin-bottom: 4px;
    font-size: 17px;
    font-weight: 550;
    color: var(--ink);
  }
  .career-timeline {
    margin: 0;
    padding: 0 0 0 6px;
    list-style: none;
  }
  .career-item {
    position: relative;
    border-left: 1px solid var(--line);
    padding: 0 0 40px 28px;
  }
  .career-item:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }
  .career-item::before {
    content: '';
    position: absolute;
    top: 4px;
    left: -6px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--paper);
  }
  .career-company-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--muted);
    overflow-wrap: break-word;
  }
  .career-item h3 {
    margin-top: 8px;
    font-size: clamp(21px, 2.1vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .career-period {
    margin-top: 8px;
    font-size: 10px;
    color: var(--muted);
  }
  .career-summary,
  .career-highlights,
  .career-technologies {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    overflow-wrap: break-word;
  }
  .career-highlights h4 {
    margin: 0;
    font-size: 14px;
    font-weight: 550;
    color: var(--ink);
  }
  .career-highlights ul {
    margin: 12px 0 0;
    padding-left: 18px;
    list-style: disc;
  }
  .career-highlights li + li {
    margin-top: 12px;
  }
  .career-technologies strong {
    font-weight: 550;
    color: var(--ink);
  }
  .is-current::before {
    border-color: var(--accent);
    background: var(--accent);
  }
  .is-current > .career-company-label,
  .is-current > h3 {
    color: var(--accent);
  }
  @media (max-width: 1100px) {
    .career-section {
      gap: 40px;
    }
  }
  @media (max-width: 900px) {
    .career-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .career-intro {
      position: static;
    }
    .career-company {
      max-width: 360px;
      margin-top: 28px;
    }
  }
  @media (max-width: 600px) {
    .career-section {
      margin-top: 48px;
      gap: 32px;
    }
    .career-item {
      padding-left: 22px;
      padding-bottom: 32px;
    }
    .career-lead {
      font-size: 16px;
    }
  }
</style>
