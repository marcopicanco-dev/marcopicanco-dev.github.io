    role: 'Auxiliar administrativo',
    startedAt: '2012-01',
    startLabel: 'jan. de 2012',
    endedAt: '2012-05',
    endLabel: 'mai. de 2012',
    summary:
      'Participei de um processo de auditoria, realizando a digitação e a migração de documentos físicos para arquivos digitais.',
