---
import Base from '@/layouts/Base.astro'
import ProfessionalJourney from '@/components/ProfessionalJourney.astro'
import { Image } from 'astro:assets'
import { CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'
import profilePhoto from '@/assets/profile/perfil-linkedin.png'
import { ABOUT, type EducationId } from '@/i18n/pages/about'
import NewTabNote from '@/components/NewTabNote.astro'
import { getLang, localizePath } from '@/i18n/utils'

const lang = getLang(Astro.currentLocale)
const c = ABOUT[lang]
const profileUrl = new URL(localizePath('/sobre/', lang), Astro.site)
const schools: {
  id: EducationId
  school: string
  logo: string
  field: string
}[] = [
  {
    id: 'puc',
    school: 'PUC Minas',
    logo: '/images/education/puc-minas.png',
    field: 'Ciência da Computação',
  },
  {
    id: 'descomplica',
    school: 'Descomplica Faculdade Digital',
    logo: '/images/education/descomplica.png',
    field: 'Tecnologia da Informação',
  },
  {
    id: 'anhanguera',
    school: 'Anhanguera Educacional',
    logo: '/images/education/anhanguera.png',
    field: 'Informática',
  },
  {
    id: 'estacio',
    school: 'Estácio',
    logo: '/images/education/estacio.png',
    field: 'Administração, Negócios e Marketing',
  },
]
const education = schools.map((item) => ({ ...item, ...c.education[item.id] }))
---

<Base
  frontmatter={{
    title: c.metaTitle,
    description: c.metaDescription,
    file: '',
  }}
>
  <main
    class="site-container about-page"
    itemscope
    itemtype="https://schema.org/ProfilePage"
    itemid={profileUrl.href}
  >
    <div class="page-breadcrumb">
      <a href={localizePath('/', lang)}>{c.breadcrumbHome}</a><span
        aria-hidden="true">/</span
      ><span>{c.breadcrumbCurrent}</span>
    </div>
    <section
      class="axis-layout section-block"
      aria-labelledby="about-page-title"
      itemprop="mainEntity"
      itemscope
      itemtype="https://schema.org/Person"
      itemid={`${profileUrl.href}#marco-picanco`}
    >
      <meta itemprop="name" content="Marco Picanço" />
      <link itemprop="url" href={profileUrl} />
      <div class="axis">
        <span class="mono">MP /</span><span class="side-label">{c.axis}</span>
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">{c.eyebrow}</p><h1
            id="about-page-title"
            class="page-title"
          >
            {c.titleLines[0]}<br /><span>{c.titleLines[1]}</span>
          </h1>
        </div>
        <div class="about-grid">
          <figure class="portrait">
            <Image
              src={profilePhoto}
              alt="Marco Picanço"
              itemprop="image"
              width={640}
              widths={[320, 640]}
              sizes="(max-width: 600px) 76vw, 320px"
              format="webp"
              decoding="async"
            /><figcaption class="mono" itemprop="jobTitle">
              {c.jobTitle}
            </figcaption>
          </figure><div class="about-copy">
            <h2>{c.heading}</h2>{
              c.paragraphs.map((paragraph) => <p>{paragraph}</p>)
            }<div class="inline-links">
              <a
                class="text-link"
                href={GITHUB_REPO_URL}
                itemprop="sameAs"
                target="_blank"
                rel="noopener noreferrer"
                >GitHub <span aria-hidden="true">↗</span><NewTabNote /></a
              ><a
                class="text-link"
                href={LINKEDIN_URL}
                itemprop="sameAs"
                target="_blank"
                rel="noopener noreferrer"
                >LinkedIn <span aria-hidden="true">↗</span><NewTabNote /></a
              >
            </div>
          </div>
        </div>
        <section class="education-section" aria-labelledby="education-title">
          <p class="eyebrow">{c.educationEyebrow}</p><h2 id="education-title">
            {c.educationTitle}
          </h2><div class="education-list">
            {
              education.map((item) => (
                <details class="education-item">
                  <>
                    <summary>
                      <>
                        <img
                          src={item.logo}
                          alt=""
                          width="48"
                          height="48"
                          loading="lazy"
                          decoding="async"
                        />
                        <div>
                          <>
                            <h3>{item.title}</h3>
                            <p>{item.school}</p>
                            <span class="mono">{item.period}</span>
                          </>
                        </div>
                        <span class="education-toggle" aria-hidden="true">
                          +
                        </span>
                      </>
                    </summary>
                    <div class="education-description">
                      <>
                        <p>{item.summary}</p>
                        <p>
                          <strong>{c.skillsLabel}</strong>{' '}
                          {item.skills.join(', ')}.
                        </p>
                      </>
                    </div>
                  </>
                </details>
              ))
            }
          </div>
        </section>
        <ProfessionalJourney />
        <div class="about-invitation">
          <h2>{c.invitation}</h2><a
            class="button button-primary"
            href={`mailto:${CONTACT_EMAIL}`}
            data-analytics-contact="email"
            data-analytics-location="about"
            >{c.contactCta} <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>
</Base>
