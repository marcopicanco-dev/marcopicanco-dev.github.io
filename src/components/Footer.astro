---
import { CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'
---

<footer class="site-footer">
  <div class="site-container footer-grid">
    <a class="footer-brand" href="/"
      >Marco Picanço<span class="brand-dot">.</span></a
    >
    <p>Software bem construído.<br />Relações bem cuidadas.</p>
    <nav aria-label="Links do rodapé">
      <a href="/blog/">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="4" y="3" width="16" height="18" rx="2"></rect>
          <path d="M8 7h8M8 11h8M8 15h5"></path>
        </svg>
        <span>Blog</span>
      </a>
      <a href={GITHUB_REPO_URL} target="_blank" rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.63 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.69.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z"></path>
        </svg>
        <span>GitHub ↗</span>
      </a>
      <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
        data-analytics-contact="linkedin" data-analytics-location="footer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.8-1.52 3 0 3.57 1.98 3.57 4.55Z"></path>
        </svg>
        <span>LinkedIn ↗</span>
      </a>
      <a href={`mailto:${CONTACT_EMAIL}`} data-analytics-contact="email" data-analytics-location="footer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        <span>E-mail ↗</span>
      </a>
    </nav>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Marco Picanço</span>
      <nav aria-label="Privacidade e termos">
        <a href="/privacidade/">Privacidade</a>
        <a href="/termos/">Termos de uso</a>
        <button type="button" data-cookie-action="preferences"
          >Preferências de cookies</button
        >
      </nav>
    </div>
  </div>
</footer>

<style>
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  nav a svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
</style>
