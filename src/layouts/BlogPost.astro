---
import Base from '@/layouts/Base.astro'
import Comments from '@/components/Comments.astro'
import {
  formatBlogDate,
  getBlogPostSlug,
  getBlogPostUrl,
  getRelatedPosts,
  getSeriesPosts,
  getTagUrl,
  hasTagPage,
  type BlogFrontmatter,
} from '@/utils/blog'
import { getCanonicalUrl } from '@/utils/seo'
const { frontmatter } = Astro.props as { frontmatter: BlogFrontmatter }
const canonicalUrl = getCanonicalUrl(Astro.url.pathname, Astro.site)
const authorUrl = new URL('/sobre/', Astro.site)
const seriesPosts = frontmatter.series ? getSeriesPosts(frontmatter.series) : []
const seriesIndex = seriesPosts.findIndex(
  (post) => getBlogPostSlug(post.frontmatter) === getBlogPostSlug(frontmatter),
)
const tags = frontmatter.tags ?? []
const relatedPosts = getRelatedPosts(frontmatter)
---

<Base frontmatter={{ ...frontmatter, file: '' }} type="article">
  <main class="post-page">
    <article
      itemscope
      itemtype="https://schema.org/BlogPosting"
      itemid={`${canonicalUrl.href}#article`}
    >
      <link itemprop="mainEntityOfPage" href={canonicalUrl} />
      <header id="post-top" class="post-header">
        <a class="text-link post-back" href="/blog/">← Todos os textos</a>
        <p class="eyebrow">Artigos</p>
        <h1 itemprop="headline">{frontmatter.title}</h1>
        <p class="post-description" itemprop="description">
          {frontmatter.description}
        </p>
        <div class="post-meta">
          <span
            itemprop="author"
            itemscope
            itemtype="https://schema.org/Person"
            itemid={`${authorUrl.href}#marco-picanco`}
            >Por <a href="/sobre/" itemprop="url"
              ><span itemprop="name">Marco Picanço</span></a
            ></span
          ><time
            class="mono"
            itemprop="datePublished"
            datetime={frontmatter.date}>{formatBlogDate(frontmatter.date)}</time
          >
        </div>
        {
          tags.length > 0 && (
            <>
              <meta itemprop="keywords" content={tags.join(', ')} />
              <ul class="post-tags" aria-label="Tags">
                {tags.map((tag) => (
                  <li>
                    {hasTagPage(tag) ? (
                      <a href={getTagUrl(tag)} rel="tag">
                        {tag}
                      </a>
                    ) : (
                      <span>{tag}</span>
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }
        {
          frontmatter.heroImage && (
            <img
              src={frontmatter.heroImage}
              itemprop="image"
              alt={frontmatter.heroImageAlt ?? ''}
              class:list={[
                'post-hero',
                { 'post-hero--logo': frontmatter.heroImageLayout === 'logo' },
              ]}
              loading="eager"
              decoding="async"
            />
          )
        }
      </header>
      <div id="markdown" class="prose" itemprop="articleBody"><slot /></div>
      {
        seriesPosts.length > 1 && (
          <nav class="series-nav" aria-labelledby="series-title">
            <p class="eyebrow">
              Série · Parte {seriesIndex + 1} de {seriesPosts.length}
            </p>
            <h2 id="series-title">{frontmatter.series}</h2>
            <ol>
              {seriesPosts.map((post, index) => {
                const label = `Parte ${index + 1} — ${post.frontmatter.seriesLabel ?? post.frontmatter.title}`

                return (
                  <li>
                    {index === seriesIndex ? (
                      <span aria-current="page">{label}</span>
                    ) : (
                      <a href={getBlogPostUrl(post.frontmatter)}>{label}</a>
                    )}
                  </li>
                )
              })}
            </ol>
          </nav>
        )
      }
      {
        relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-title">
            <h2 id="related-title" class="eyebrow">
              Leia também
            </h2>
            {relatedPosts.map((post) => (
              <article class="archive-row">
                <time class="mono" datetime={post.frontmatter.date}>
                  {formatBlogDate(post.frontmatter.date)}
                </time>
                <div>
                  <h3>
                    <a href={getBlogPostUrl(post.frontmatter)}>
                      {post.frontmatter.title}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p>{post.frontmatter.description}</p>
                </div>
              </article>
            ))}
          </section>
        )
      }
      <Comments />
      <footer class="post-footer">
        <a class="text-link" href="/blog/">← Voltar para o blog</a><a
          class="text-link"
          href="#post-top">Voltar ao início ↑</a
        >
      </footer>
    </article>
  </main>
</Base>
