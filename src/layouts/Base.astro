---
import HeadSeo from '@/components/HeadSeo.astro'
import Nav from '@/components/navigation/Nav.astro'
import Footer from '@/components/Footer.astro'
import CookieConsent from '@/components/CookieConsent.astro'
import { LOCALE_INFO } from '@/i18n/ui'
import { getLang, getTranslations } from '@/i18n/utils'
import { type Frontmatter } from '@/types'
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import '@/styling/tailwind.css'
import '@/styling/scrollbar.css'
import '@/styling/code.css'
import '@/styling/modernism.css'

const { frontmatter, type = 'website' } = Astro.props as {
  frontmatter?: Frontmatter
  type?: string
}
const lang = getLang(Astro.currentLocale)
const t = getTranslations(lang)
---

<style is:global>
  @font-face {
    font-family: 'Inter Variable';
    font-style: normal;
    font-display: swap;
    font-weight: 100 900;
    src: url('@fontsource-variable/inter/files/inter-latin-wght-normal.woff2')
      format('woff2');
  }
</style>

<html data-theme="dracula" lang={LOCALE_INFO[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link
      rel="preload"
      href={interUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <HeadSeo type={type} frontmatter={frontmatter} />
    <script is:inline src="/scripts/site.js"></script>
    <script is:inline defer src="/scripts/theme-switcher.js"></script>
    <script is:inline defer src="/scripts/consent.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t('a11y.skipToContent')}</a>
    <Nav />
    <div id="conteudo" tabindex="-1"><slot /></div>
    <Footer />
    <CookieConsent />
  </body>
</html>
