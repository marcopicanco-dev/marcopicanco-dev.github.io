---
import Base from '@/layouts/Base.astro'
import { formatBlogDate } from '@/utils/blog'
import { getLang, getTranslations } from '@/i18n/utils'

const { frontmatter } = Astro.props as {
  frontmatter: { title: string; description: string; updated: string }
}
const lang = getLang(Astro.currentLocale)
const t = getTranslations(lang)
---

<Base frontmatter={{ ...frontmatter, layout: '', file: '' }}>
  <main class="post-page">
    <header class="post-header">
      <p class="eyebrow">{t('legal.eyebrow')}</p>
      <h1>{frontmatter.title}</h1>
      <p class="post-description">{frontmatter.description}</p>
      <div class="post-meta">
        <span>{t('legal.updated')}</span><time
          class="mono"
          datetime={frontmatter.updated}
          >{formatBlogDate(frontmatter.updated, lang)}</time
        >
      </div>
    </header>
    <div id="markdown" class="prose"><slot /></div>
  </main>
</Base>
