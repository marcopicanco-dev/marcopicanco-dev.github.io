---
import Base from '@/layouts/Base.astro'
import {
  getBlogSearchRecords,
  getBlogPosts,
  getBlogPostUrl,
  sortBlogPostsByDateDesc,
  formatBlogDate,
} from '@/utils/blog'
import BlogArchive from '@/components/BlogArchive'
import Search from '@/components/navigation/Search.astro'

const archivePosts = sortBlogPostsByDateDesc(getBlogPosts()).map((post) => ({
  title: post.frontmatter.title,
  description: post.frontmatter.description,
  date: post.frontmatter.date,
  formattedDate: formatBlogDate(post.frontmatter.date),
  url: getBlogPostUrl(post.frontmatter),
}))
---

<Base
  frontmatter={{
    title: 'Blog',
    description:
      'Notas sobre programação, segurança, matemática e tecnologia. Experimentos, decisões de engenharia e aprendizados de Marco Picanço.',
    file: '',
  }}
>
  <main class="site-container blog-page">
    <header class="axis-layout blog-heading">
      <div class="axis">
        <span class="mono">MP /</span><span class="side-label"
          >Caderno aberto</span
        >
      </div>
      <div class="axis-content">
        <p class="eyebrow">Programação, matemática e tecnologia</p><h1
          class="page-title"
        >
          Ideias em código.<br /><span>Aprendizados em palavras.</span>
        </h1><div class="blog-heading-bottom">
          <p>
            Um registro do que estudo, construo e descubro pelo caminho. Com
            problemas reais e decisões explicadas.
          </p><Search items={getBlogSearchRecords()} lang="pt" />
        </div>
      </div>
    </header>
    <BlogArchive posts={archivePosts} client:load />
  </main>
</Base>
