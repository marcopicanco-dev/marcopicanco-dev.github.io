---
import BlogPost from '@/layouts/BlogPost.astro'
import { getLanguageStaticPaths } from '@/i18n/utils'
import { getPostStaticPaths, type BlogPostModule } from '@/utils/blog'
import { type GetStaticPaths } from 'astro'

export const getStaticPaths = (() =>
  getLanguageStaticPaths().flatMap(({ params }) =>
    getPostStaticPaths(params.lang).map((path) => ({
      params: { ...params, ...path.params },
      props: path.props,
    })),
  )) satisfies GetStaticPaths

const { post } = Astro.props as { post: BlogPostModule }
const { Content } = post
---

<BlogPost frontmatter={post.frontmatter}>
  <Content />
</BlogPost>
