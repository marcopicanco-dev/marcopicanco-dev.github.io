---
import Base from '@/layouts/Base.astro'
import ProfessionalJourney from '@/components/ProfessionalJourney.astro'
import { Image } from 'astro:assets'
import { CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'
import profilePhoto from '@/assets/profile/perfil-linkedin.png'
const profileUrl = new URL('/sobre/', Astro.site)
const education = [
  {
    school: 'PUC Minas',
    logo: '/images/education/puc-minas.png',
    title: 'Pós-graduação em Engenharia de Software',
    field: 'Ciência da Computação',
    period: 'mar de 2023 - abr de 2024',
    summary:
      'Formação com base em Ciência da Computação, Matemática e Produção, voltada à construção, operação, manutenção e evolução de soluções de software de alta qualidade. Integra práticas técnicas e gerenciais, tecnologias modernas e inovação, considerando aspectos éticos, sociais, legais, econômicos e de segurança. Abrange arquitetura de software, liderança técnica, gestão de projetos, pesquisa e melhoria contínua dos processos de desenvolvimento.',
    skills: [
      'Análise, modelagem e especificação de software',
      'Arquitetura e projeto de software',
      'Programação e construção de software',
      'Testes de software e garantia da qualidade',
      'Gestão de projetos de software',
      'Gerência de configuração e evolução de software',
      'Gestão da produção e melhoria contínua de processos',
      'Gestão de equipes e liderança técnica',
      'Comunicação com stakeholders',
      'Interação humano-computador',
      'Lógica matemática e estatística aplicada',
      'Bancos de dados',
      'Redes de computadores e sistemas operacionais',
      'Sistemas distribuídos',
      'Segurança de software',
      'Tecnologias móveis e computação em nuvem',
    ],
  },
  {
    school: 'Descomplica Faculdade Digital',
    logo: '/images/education/descomplica.png',
    title: 'MBA em Big Data',
    field: 'Tecnologia da Informação',
    period: '2020 - 2021',
    summary:
      'Estudo conceitual e prático de Big Data e Business Analytics, com foco em análise de problemas empresariais, projetos com grandes volumes de dados, qualidade e governança.',
    skills: [
      'Conceitos fundamentais e aplicações de Big Data e Analytics',
      'Filtragem e processamento de dados brutos para geração de informações úteis',
      'Introdução a ferramentas do ecossistema de dados, como Hadoop, Spark e Kafka',
      'Metodologias aplicadas à inteligência competitiva e de mercado',
    ],
  },
  {
    school: 'Anhanguera Educacional',
    logo: '/images/education/anhanguera.png',
    title: 'Ciência da Computação',
    field: 'Informática',
    period: '2017 - 2021',
    summary:
      'Formação em técnicas, métodos e ferramentas computacionais para automatizar processos e desenvolver sistemas, incluindo modelagem, testes, redes, bancos de dados e inteligência artificial.',
    skills: [
      'Algoritmos e estruturas de dados',
      'Programação orientada a objetos com Java',
      'Desenvolvimento web e mobile',
      'Engenharia de Software',
      'Matemática computacional',
      'Lógica',
      'Sistemas operacionais',
      'Arquitetura de computadores',
      'Computação em nuvem',
      'Fundamentos de inteligência artificial (IA)',
      'Machine Learning',
      'Segurança da informação',
      'Redes de computadores',
      'Bancos de dados',
      'Internet das Coisas (IoT)',
    ],
  },
  {
    school: 'Estácio',
    logo: '/images/education/estacio.png',
    title: 'Bacharelado em Administração',
    field: 'Administração, Negócios e Marketing',
    period: '2002 - 2006',
    summary:
      'Formação em Administração com foco em gestão estratégica, empreendedorismo, finanças, contabilidade, marketing e negociação. Abrange gestão de pessoas, logística e cadeia de suprimentos, além de direito empresarial, cenários econômicos e estatística aplicada ao planejamento e à tomada de decisão nos negócios.',
    skills: [
      'Teoria Geral da Administração',
      'Planejamento estratégico',
      'Empreendedorismo',
      'Administração financeira',
      'Contabilidade geral',
      'Orçamentos e custos',
      'Administração de marketing',
      'Comportamento do consumidor',
      'Negociação',
      'Gestão de recursos humanos',
      'Logística e cadeia de suprimentos',
      'Direito empresarial',
      'Cenários econômicos',
      'Estatística aplicada',
    ],
  },
]
---

<Base
  frontmatter={{
    title: 'Desenvolvedor Full Stack Ruby on Rails',
    description:
      'Conheça a trajetória de Marco Picanço: desenvolvimento web, Ruby on Rails, Engenharia de Software e uma visão de negócios construída com pessoas.',
    file: '',
  }}
>
  <main
    class="site-container about-page"
    itemscope
    itemtype="https://schema.org/ProfilePage"
    itemid={profileUrl.href}
  >
    <div class="page-breadcrumb">
      <a href="/">Início</a><span aria-hidden="true">/</span><span>Sobre</span>
    </div>
    <section
      class="axis-layout section-block"
      aria-labelledby="about-page-title"
      itemprop="mainEntity"
      itemscope
      itemtype="https://schema.org/Person"
      itemid={`${profileUrl.href}#marco-picanco`}
    >
      <meta itemprop="name" content="Marco Picanço" />
      <link itemprop="url" href={profileUrl} />
      <div class="axis">
        <span class="mono">MP /</span><span class="side-label">Trajetória</span>
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">Pessoas, negócios e software.</p><h1
            id="about-page-title"
            class="page-title"
          >
            Sou Marco Picanço.<br /><span>Prazer em construir.</span>
          </h1>
        </div>
        <div class="about-grid">
          <figure class="portrait">
            <Image
              src={profilePhoto}
              alt="Marco Picanço"
              itemprop="image"
              width={640}
              widths={[320, 640]}
              sizes="(max-width: 600px) 76vw, 320px"
              format="webp"
              decoding="async"
            /><figcaption class="mono" itemprop="jobTitle">
              Desenvolvedor Full Stack
            </figcaption>
          </figure><div class="about-copy">
            <h2>Entender o problema faz parte de escrever o código.</h2><p>
              Minha trajetória passa por Administração, vendas e sucesso do
              cliente antes de chegar ao desenvolvimento de software. Trabalhar
              perto de pessoas e negócios me ensinou a fazer perguntas, entender
              prioridades e cuidar da comunicação.
            </p><p>
              No desenvolvimento Full Stack, minha experiência inclui APIs,
              testes automatizados e evolução de backoffice com Ruby on Rails na
              OrçaFascio. Trabalho com regras de negócio, integrações e
              manutenção de sistemas, com atenção à qualidade e à clareza do
              código.
            </p><p>
              A formação em Engenharia de Software, Big Data e Ciência da
              Computação complementa essa prática. Fora do código, o jiu-jitsu
              me ajuda a cultivar disciplina e calma para lidar com desafios.
            </p><div class="inline-links">
              <a
                class="text-link"
                href={GITHUB_REPO_URL}
                itemprop="sameAs"
                target="_blank"
                rel="noopener noreferrer">GitHub ↗</a
              ><a
                class="text-link"
                href={LINKEDIN_URL}
                itemprop="sameAs"
                target="_blank"
                rel="noopener noreferrer">LinkedIn ↗</a
              >
            </div>
          </div>
        </div>
        <section class="education-section" aria-labelledby="education-title">
          <p class="eyebrow">Base para a prática</p><h2 id="education-title">
            Formação acadêmica.
          </h2><div class="education-list">
            {
              education.map((item) => (
                <details class="education-item">
                  <>
                    <summary>
                      <>
                        <img
                          src={item.logo}
                          alt=""
                          width="48"
                          height="48"
                          loading="lazy"
                          decoding="async"
                        />
                        <div>
                          <>
                            <h3>{item.title}</h3>
                            <p>{item.school}</p>
                            <span class="mono">{item.period}</span>
                          </>
                        </div>
                        <span class="education-toggle" aria-hidden="true">
                          +
                        </span>
                      </>
                    </summary>
                    <div class="education-description">
                      <>
                        <p>{item.summary}</p>
                        <p>
                          <strong>Competências:</strong>{' '}
                          {item.skills.join(', ')}.
                        </p>
                      </>
                    </div>
                  </>
                </details>
              ))
            }
          </div>
        </section>
        <ProfessionalJourney />
        <div class="about-invitation">
          <h2>Vamos conversar sobre o seu projeto?</h2><a
            class="button button-primary"
            href={`mailto:${CONTACT_EMAIL}`}
            data-analytics-contact="email"
            data-analytics-location="about"
            >Entrar em contato <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>
</Base>
