---
import Base from '@/layouts/Base.astro'
import { CONTACT_EMAIL, GITHUB_REPO_URL, LINKEDIN_URL } from '@/config'
const education = [
  {
    school: 'PUC Minas',
    logo: '/images/education/puc-minas.png',
    title: 'Pós-graduação em Engenharia de Software',
    field: 'Ciência da Computação',
    period: 'mar de 2023 - abr de 2024',
    summary:
      'Formação voltada a padrões, práticas e processos de Engenharia de Software para projetar, desenvolver, garantir qualidade e gerenciar soluções de software que geram valor ao negócio.',
    skills: ['SQL', 'Resolução de problemas', 'Engenharia de Software'],
  },
  {
    school: 'Descomplica Faculdade Digital',
    logo: '/images/education/descomplica.png',
    title: 'MBA em Big Data',
    field: 'Tecnologia da Informação',
    period: '2020 - 2021',
    summary:
      'Estudo conceitual e prático de Big Data e Business Analytics, com foco em análise de problemas empresariais, projetos com grandes volumes de dados, qualidade e governança.',
    skills: ['SQL', 'Resolução de problemas', 'Big Data'],
  },
  {
    school: 'Anhanguera Educacional',
    logo: '/images/education/anhanguera.png',
    title: 'Ciência da Computação',
    field: 'Informática',
    period: '2017 - 2021',
    summary:
      'Formação em técnicas, métodos e ferramentas computacionais para automatizar processos e desenvolver sistemas, incluindo modelagem, testes, redes, bancos de dados e inteligência artificial.',
    skills: ['SQL', 'Resolução de problemas', 'Programação'],
  },
  {
    school: 'Estácio',
    logo: '/images/education/estacio.png',
    title: 'Bacharelado em Administração',
    field: 'Administração, Negócios e Marketing',
    period: '2002 - 2006',
    summary:
      'Base em Administração de empresas com foco em Marketing, mundo corporativo, estudos, pesquisas e visão prática sobre negócios.',
    skills: ['Planejamento de eventos', 'Gestão de mudanças', 'Marketing'],
  },
]
---

<Base
  frontmatter={{
    title: 'Sobre',
    description:
      'Conheça a trajetória de Marco Picanço: desenvolvimento web, Ruby on Rails, Engenharia de Software e uma visão de negócios construída com pessoas.',
    file: '',
  }}
>
  <main class="site-container about-page">
    <div class="page-breadcrumb">
      <a href="/">Início</a><span aria-hidden="true">/</span><span>Sobre</span>
    </div>
    <section
      class="axis-layout section-block"
      aria-labelledby="about-page-title"
    >
      <div class="axis">
        <span class="mono">MP /</span><span class="side-label">Trajetória</span>
      </div>
      <div class="axis-content">
        <div class="section-heading">
          <p class="eyebrow">Pessoas, negócios e software.</p><h1
            id="about-page-title"
            class="page-title"
          >
            Sou Marco Picanço.<br /><span>Prazer em construir.</span>
          </h1>
        </div>
        <div class="about-grid">
          <figure class="portrait">
            <img
              src="/images/perfil.webp"
              alt="Marco Picanço"
              width="640"
              height="800"
              decoding="async"
            /><figcaption class="mono">Desenvolvedor Full Stack</figcaption>
          </figure><div class="about-copy">
            <h2>Entender o problema faz parte de escrever o código.</h2><p>
              Minha trajetória passa por Administração, vendas e sucesso do
              cliente antes de chegar ao desenvolvimento de software. Trabalhar
              perto de pessoas e negócios me ensinou a fazer perguntas, entender
              prioridades e cuidar da comunicação.
            </p><p>
              No desenvolvimento Full Stack, minha experiência inclui APIs,
              testes automatizados e evolução de backoffice com Ruby on Rails na
              OrçaFascio. Trabalho com regras de negócio, integrações e
              manutenção de sistemas, com atenção à qualidade e à clareza do
              código.
            </p><p>
              A formação em Engenharia de Software, Big Data e Ciência da
              Computação complementa essa prática. Fora do código, o jiu-jitsu
              me ajuda a cultivar disciplina e calma para lidar com desafios.
            </p><div class="inline-links">
              <a
                class="text-link"
                href={GITHUB_REPO_URL}
                target="_blank"
                rel="noopener noreferrer">GitHub ↗</a
              ><a
                class="text-link"
                href={LINKEDIN_URL}
                target="_blank"
                rel="noopener noreferrer">LinkedIn ↗</a
              >
            </div>
          </div>
        </div>
        <section class="education-section" aria-labelledby="education-title">
          <p class="eyebrow">Base para a prática</p><h2 id="education-title">
            Formação acadêmica.
          </h2><div class="education-list">
            {
              education.map((item) => (
                <details class="education-item">
                  <>
                    <summary>
                      <>
                        <img
                          src={item.logo}
                          alt=""
                          width="48"
                          height="48"
                          loading="lazy"
                          decoding="async"
                        />
                        <div>
                          <>
                            <h3>{item.title}</h3>
                            <p>{item.school}</p>
                            <span class="mono">{item.period}</span>
                          </>
                        </div>
                        <span class="education-toggle" aria-hidden="true">
                          +
                        </span>
                      </>
                    </summary>
                    <div class="education-description">
                      <>
                        <p>{item.summary}</p>
                        <p>
                          <strong>Competências:</strong>{' '}
                          {item.skills.join(', ')}.
                        </p>
                      </>
                    </div>
                  </>
                </details>
              ))
            }
          </div>
        </section>
        <div class="about-invitation">
          <h2>Vamos conversar sobre o seu projeto?</h2><a
            class="button button-primary"
            href={`mailto:${CONTACT_EMAIL}`}
            >Entrar em contato <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </main>
</Base>
