---
import BlogPost from '@/layouts/BlogPost.astro'
import { DEFAULT_LANGUAGE_CODE } from '@/config'
import { getPostStaticPaths, type BlogPostModule } from '@/utils/blog'
import { type GetStaticPaths } from 'astro'

export const getStaticPaths = (() =>
  getPostStaticPaths(DEFAULT_LANGUAGE_CODE)) satisfies GetStaticPaths

const { post } = Astro.props as { post: BlogPostModule }
const { Content } = post
---

<BlogPost frontmatter={post.frontmatter}>
  <Content />
</BlogPost>
