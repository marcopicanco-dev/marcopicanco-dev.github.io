---
import BlogPost from '@/layouts/BlogPost.astro'
import {
  getBlogPostSlug,
  type BlogFrontmatter,
} from '@/utils/blog'
import { type GetStaticPaths, type MarkdownInstance } from 'astro'

type BlogPostModule = MarkdownInstance<BlogFrontmatter>

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = (await Astro.glob(
    '../content/blog/*.mdx',
  )) as BlogPostModule[]

  return posts.map((post) => ({
    params: {
      slug: getBlogPostSlug(post.frontmatter),
    },
    props: {
      post,
    },
  }))
}

const { post } = Astro.props as { post: BlogPostModule }
const { Content } = post
---

<BlogPost frontmatter={post.frontmatter}>
  <Content />
</BlogPost>
