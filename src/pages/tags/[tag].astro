---
import TagPage from '@/components/TagPage.astro'
import { DEFAULT_LANGUAGE_CODE } from '@/config'
import { getTagStaticPaths, type BlogPostModule } from '@/utils/blog'
import { type GetStaticPaths } from 'astro'

export const getStaticPaths = (() =>
  getTagStaticPaths(DEFAULT_LANGUAGE_CODE)) satisfies GetStaticPaths

const { tag, posts } = Astro.props as { tag: string; posts: BlogPostModule[] }
---

<TagPage tag={tag} posts={posts} />
