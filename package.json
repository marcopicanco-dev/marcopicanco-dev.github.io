{
  "name": "stellar",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "a11y": "node scripts/run-axe.mjs",
    "a11y:blog": "node scripts/run-axe.mjs http://localhost:4321/blog/",
    "a11y:portfolio": "node scripts/run-axe.mjs http://localhost:4321/portfolio/",
    "format": "prettier '**/*.{cjs,mjs,ts,tsx,md,mdx,json,astro}' --write",
    "lint": "eslint .",
    "security:audit": "npm audit --audit-level=moderate --omit=dev",
    "security:csp": "node scripts/print-csp-header.mjs",
    "security:headers": "node scripts/check-production-headers.mjs",
    "security:test": "node --test tests/security.test.mjs",
    "security": "npm run typecheck && npm run security:test && npm run security:audit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@fontsource/karla": "^5.0.18",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "astro": "^7.1.3",
    "astro-expressive-code": "^0.44.1",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.0",
    "fuse.js": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/eslint": "^8.56.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "^0.16.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.31.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "vite": "^8.1.5"
  }
}
